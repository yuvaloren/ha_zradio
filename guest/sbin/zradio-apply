#!/usr/bin/env bash
# zradio-apply — writes a synced set onto THIS VM's sticks: the standby's half of a sync. Runs INSIDE a radio VM as
# root, called by zradio-sync's receive (and reapply) with the directory the set was unpacked into. Report mode unless
# --run. Nothing here ever prints a key, an NVM byte or the Zigbee network key.
#
#   zradio-apply [--run] [--only zwave|zigbee] [--force] [--zui-image IMAGE] --from DIR
#   --from DIR: the set, as zradio-sync prepared it: fetch.json (the set's id and the identities to verify: home ID,
#            node count, RF region and transmit power; IEEE, PAN, channel), zwave-nvm.bin, zha-backup-restore.json
#            (zigpy's open coordinator backup with the frame counter already raised).
#   --force: both Z-Wave passes run even when the stick already verifies (what a newer set triggers by itself)
#
# Steps with --run, in order (OK / WARN / FAIL / DONE lines; a FAIL in the checks changes nothing):
#   0. checks: root; the ttys of the networks asked for; ser2net NOT active (a VM that serves never writes over
#      itself); the set's files; podman with the pinned Z-Wave JS UI image present (pulled at install — a sync must not
#      depend on the internet); zigpy at $ZIGPY.
#   1. the set: its identities read from fetch.json.
#   2. Z-Wave, two passes, each in a Z-Wave JS UI container on the stick (store $ZUI_STORE: port /dev/zwave, no MQTT,
#      no gateway, no RF settings) that is stopped THE MOMENT the call answers (a driver restarted on the restored
#      image would interview the mesh next to the live controller), its log kept in DIR, then zradio-probe.py
#      --soft-reset (the controller reloads its NVM) + read-only serial reads:
#      (a) CONVERTING — restoreNVM(useRaw=false): zwave-js migrates the image into this stick's NVM; the stick takes
#          the image's home ID + node table. Verified: home ID and node count == fetch.json. [V: a raw pass alone left
#          a blank Aeotec Z-Stick 10 Pro on its own home ID with the image's node table.]
#      (b) RAW — restoreNVM(useRaw=true): the image as it is, which repairs the RF config the converting pass misreads
#          on that stick (region "unknown", 0 dBm). Verified: the set's RF region and power, home ID kept.
#      A pass is skipped when its verification already holds (re-runs resume) — unless the set is another one than the
#      last record's: then both run (the stick must hold THIS set). The stick's receiver is switched OFF right after
#      each pass, the moment its container is stopped, and once more at the end (zradio-probe.py --rf-receive off):
#      a powered copy with the live home ID otherwise receives and ACKs the mesh's frames next to the live controller
#      [V: 2 of 121 routed commands on the live mesh took 14–16 s in the ~15 s a restored copy listened].
#   3. Zigbee: zigpy radio znp <tty> restore zha-backup-restore.json (the coordinator forms the restored network:
#      IEEE, PAN, channel, keys, the raised counter) → zigpy … info: IEEE, PAN, channel == fetch.json, and the frame
#      counter not below the one written. The coordinator
#      is on the air from the restore until the caller silences it — seconds (zradio-sync runs zradio-serve down next).
#   4. the record: $STATE/last-restore.json (+ a dated copy) — the set, the identities, the verification; no secret.
# Exit 0 = every asked network written and verified; 1 = a FAIL (what was already done stays done: a re-run resumes).
# [V reference pair 2026-11-11: 90–97 s for both networks.] Tests: tests/t-apply.sh. Env: ZRADIO_APPLY_*.
set -uo pipefail
RUN=0 ONLY="" FORCE_ARG=0 FROM=""
LIB=${ZRADIO_LIB:-$(cd "$(dirname "$0")/../lib" 2>/dev/null && pwd)}; [ -r "$LIB/zradio-common.sh" ] || LIB=/usr/local/lib/zradio
# shellcheck source=../lib/zradio-common.sh
. "$LIB/zradio-common.sh" || exit 2
ZUI_IMAGE_ARG=${ZRADIO_APPLY_ZUI_IMAGE:-}
while [ $# -gt 0 ]; do case "$1" in
  --run) RUN=1; shift;; --only) ONLY=$2; shift 2;; --force) FORCE_ARG=1; shift;; --from) FROM=$2; shift 2;; --zui-image) ZUI_IMAGE_ARG=$2; shift 2;;
  -h|--help) sed -n '2,/^set -uo pipefail$/{/^set -uo pipefail$/!p}' "$0"; exit 0;; *) echo "unknown arg: $1" >&2; exit 2;; esac; done
case "$ONLY" in ""|zwave|zigbee) ;; *) echo "die: --only zwave|zigbee" >&2; exit 2;; esac
[ -n "$FROM" ] || { echo "die: --from DIR (the set to write)" >&2; exit 2; }
TOOLS=${ZRADIO_APPLY_TOOLS:-$LIB}
PROBE="$TOOLS/zradio-probe.py"
STATE=${ZRADIO_APPLY_STATE:-/var/lib/zradio}
RUN_DIR=${ZRADIO_APPLY_RUN:-/run/zradio}      # where keepalived's last word is (zradio-notify)
ZUI_STORE=${ZRADIO_APPLY_ZUI_STORE:-/etc/zradio/zui}
ZIGPY=${ZRADIO_APPLY_ZIGPY:-/opt/zradio/zigpy/bin/zigpy}
ZUI_PORT=8091             # Z-Wave JS UI's web port: its own in the container, published as the same on 127.0.0.1
ZUI_URL="http://127.0.0.1:$ZUI_PORT"
ZUI_WAIT=180              # s zui-restore.py waits for the driver and the restore
QUICK_TRIES=5             # right after a pass the restored copy listens to the mesh: its receiver off within ~2 s …
QUICK_PAUSE=0.5           # … so the tries come fast (zradio-serve down tries again, at its own pace, afterward)
READ_TRIES=5              # serial reads: right after a power-up or SoftReset the stick answers CAN for ~5 s
READ_PAUSE=3
KEEP_DAYS=30              # dated restore records are kept this long
ZIGPY_TIMEOUT=180         # s for one zigpy call (the restore, the info): it ends, or is ended, and the write fails
zr_load_radios || true
ZWAVE_TTY=${ZRADIO_APPLY_ZWAVE_TTY:-$ZWAVE_TTY}
ZIGBEE_TTY=${ZRADIO_APPLY_ZIGBEE_TTY:-$ZIGBEE_TTY}
zr_load_conf 2>/dev/null || ZUI_IMAGE=$ZR_ZUI_IMAGE     # no usable conf: the kit's own pin
[ -z "$ZUI_IMAGE_ARG" ] || ZUI_IMAGE=$ZUI_IMAGE_ARG
CT=zradio-zui
want() { [ -z "$ONLY" ] || [ "$ONLY" = "$1" ]; }   # want <net>

MODE=REPORT; [ $RUN = 1 ] && MODE=RUN
echo "== 0. checks ($MODE mode) =="
[ "$(id -u)" = 0 ] && ok "root" || bad "not root"
for f in zradio-probe.py zui-restore.py; do [ -f "$TOOLS/$f" ] && ok "$TOOLS/$f" || bad "$TOOLS/$f missing"; done
no_tty() { bad "no $1 (the udev rule zradio-detect wrote / the stick / the USB passthrough)"; }
if want zwave; then [ -e "$ZWAVE_TTY" ] && ok "Z-Wave stick at $ZWAVE_TTY" || no_tty "$ZWAVE_TTY"; fi
if want zigbee; then [ -e "$ZIGBEE_TTY" ] && ok "Zigbee stick at $ZIGBEE_TTY" || no_tty "$ZIGBEE_TTY"; fi
zr_serving && bad "ser2net is active — a radio VM that serves never writes over itself (zradio-sync applies on the standby only)" || ok "ser2net not active"
# …nor one that holds the role with ser2net stopped for a moment (a sync's read)
if [ "$(cut -d' ' -f1 "$RUN_DIR/role" 2>/dev/null)" = MASTER ]; then bad "keepalived's last word here is MASTER: this VM holds the role — nothing is written onto its sticks"; fi
[ -f "$FROM/fetch.json" ] && ok "the set in $FROM: fetch.json" || bad "$FROM: no fetch.json there"
if want zwave; then [ -s "$FROM/zwave-nvm.bin" ] && ok "the set: zwave-nvm.bin" || bad "$FROM: no zwave-nvm.bin"; fi
if want zigbee; then [ -s "$FROM/zha-backup-restore.json" ] && ok "the set: zha-backup-restore.json" || bad "$FROM: no zha-backup-restore.json"; fi
if want zwave; then
  command -v podman >/dev/null && ok "podman $(podman --version 2>/dev/null | awk '{print $3}')" || bad "podman missing"
  podman image exists "$ZUI_IMAGE" 2>/dev/null && ok "image $ZUI_IMAGE present" \
    || bad "image $ZUI_IMAGE not present — the installer pulls it (podman pull $ZUI_IMAGE)"
  if podman container exists "$CT" 2>/dev/null; then      # (only with --run: a look must not stop a write that is under way)
    if [ $RUN = 1 ]; then podman rm -f "$CT" >/dev/null 2>&1 && warn "a stale $CT container removed"; else warn "a $CT container is there (a write under way, or a stale one): --run removes it first"; fi
  fi
  [ -f "$ZUI_STORE/settings.json" ] && ok "Z-Wave JS UI store $ZUI_STORE (settings.json)" || bad "no $ZUI_STORE/settings.json"
fi
if want zigbee; then [ -x "$ZIGPY" ] && ok "zigpy at $ZIGPY" || bad "no zigpy at $ZIGPY"; fi
echo "== checks: $FAILS FAIL =="
[ $FAILS -eq 0 ] || { echo "REFUSED: fix the FAIL lines; nothing was changed"; exit 1; }
DIR=$FROM
fetch() { zr_json "$DIR/fetch.json" "$1"; }
ZW_HOME=$(fetch identities.zwave.home_id); ZW_NODES=$(fetch identities.zwave.nodes)
EXPECT_REGION=$(fetch identities.zwave.rf_region); EXPECT_POWER=$(fetch identities.zwave.tx_power_dbm)
[ -z "$EXPECT_POWER" ] || EXPECT_POWER=$(python3 -c 'import sys; print("%g" % float(sys.argv[1]))' "$EXPECT_POWER")
ZB_IEEE=$(fetch identities.zigbee.ieee); ZB_PAN=$(fetch identities.zigbee.pan_id); ZB_CH=$(fetch identities.zigbee.channel)
if want zwave && { [ -z "$ZW_HOME" ] || [ -z "$ZW_NODES" ] || [ -z "$EXPECT_REGION" ] || [ -z "$EXPECT_POWER" ]; }; then
  bad "fetch.json names no Z-Wave identity (home ID, nodes, RF region, power) — nothing to verify against, nothing written"; exit 1; fi
if want zigbee && { [ -z "$ZB_IEEE" ] || [ -z "$ZB_PAN" ] || [ -z "$ZB_CH" ]; }; then
  bad "fetch.json names no Zigbee identity (IEEE, PAN, channel) — nothing to verify against, nothing written"; exit 1; fi
if [ $RUN = 0 ]; then
  would "use the set in $FROM"
  want zwave && would "Z-Wave: $ZUI_IMAGE on $ZWAVE_TTY → converting pass (home ID $ZW_HOME, $ZW_NODES nodes) → raw pass \
(RF $EXPECT_REGION at $EXPECT_POWER dBm), each: podman stop the instant it answers → the receiver off → zradio-probe.py --soft-reset"
  want zigbee && would "Zigbee: $ZIGPY radio znp $ZIGBEE_TTY restore <zha-backup-restore.json> → info == fetch.json"
  echo "REPORT ONLY — nothing changed. Re-run with --run."; exit 0
fi

# However this write ends — a FAIL, a timeout that kills it, a stopped unit — no Z-Wave JS UI stays on the stick (a
# driver left running there would interview the live mesh), and a stick that a pass left listening is turned off.
IN_PASS=0
cleanup() {
  local rc=$?
  trap - EXIT INT TERM HUP
  if [ $IN_PASS = 1 ]; then
    podman rm -f "$CT" >/dev/null 2>&1
    zr_receiver off "$ZWAVE_TTY" "$DIR/probe-rf-off-end.err" "$QUICK_TRIES" "$QUICK_PAUSE" || true
  fi
  exit $rc
}
trap cleanup EXIT; trap 'exit 143' TERM; trap 'exit 130' INT; trap 'exit 129' HUP

TS=$(date -u +%Y%m%dT%H%M%SZ)
echo "== 1. the set in $DIR =="
want zwave && done_ "Z-Wave set $(fetch sets.zwave): home ID $ZW_HOME, $ZW_NODES nodes, $(wc -c < "$DIR/zwave-nvm.bin" | tr -d ' ') bytes"
want zigbee && done_ "Zigbee set $(fetch sets.zigbee): IEEE $ZB_IEEE, PAN $ZB_PAN, channel $ZB_CH, counter $(fetch bump.from) → $(fetch bump.to)"
mkdir -p "$STATE"; REC="$STATE/restore-$TS.json"
record() { # record <zwave|zigbee|init> <json>: one part of the record
  python3 - "$REC" "$1" "${2:-}" "$TS" "$DIR/fetch.json" <<'PY'
import json, sys
path, part, value, ts, fetch = sys.argv[1:6]
if part == "init": rec = {"ts": ts, "fetch": json.load(open(fetch)), "zwave": None, "zigbee": None}
else: rec = json.load(open(path)); rec[part] = json.loads(value)
json.dump(rec, open(path, "w"), indent=1)
PY
}
record init

if want zwave; then
  echo "== 2. Z-Wave: two passes through a local Z-Wave JS UI — converting (home ID + nodes), then raw (the RF config) =="
  zw_pass() { # zw_pass <converting|raw> <extra zui args…>
    local mode=$1; shift
    local DEV; DEV=$(readlink -f "$ZWAVE_TTY")   # the udev symlink's target: podman maps the device node itself
    podman container exists "$CT" 2>/dev/null && podman rm -f "$CT" >/dev/null 2>&1
    # The image is the one the installer pulled, run with the rights zradio-common.sh names (ZR_ZUI_RUN_OPTS).
    local perr; IN_PASS=1
    # shellcheck disable=SC2086  # the options, as words
    if perr=$(podman run -d --name "$CT" $ZR_ZUI_RUN_OPTS \
         --device "$DEV:/dev/zwave" -p "127.0.0.1:$ZUI_PORT:$ZUI_PORT" -v "$ZUI_STORE:/usr/src/app/store" "$ZUI_IMAGE" 2>&1 >/dev/null); then
      ok "container $CT started on $ZWAVE_TTY ($DEV → /dev/zwave; $ZUI_IMAGE) for the $mode pass"
    else bad "podman run $CT failed: $(printf '%s' "$perr" | tail -n 1 | cut -c1-200)"; exit 1; fi
    python3 "$TOOLS/zui-restore.py" restore --url "$ZUI_URL" --nvm "$DIR/zwave-nvm.bin" --mode "$mode" \
      --expect-home-id "$ZW_HOME" --expect-nodes "$ZW_NODES" --wait "$ZUI_WAIT" "$@" 2>&1 | sed 's/^/    /'
    local rc=${PIPESTATUS[0]}
    podman stop -t 2 "$CT" >/dev/null 2>&1
    # the stick holds a network now and listens: its receiver off AT ONCE, before the logs, the SoftReset and the reads.
    # The setting survives the SoftReset that follows.
    if zr_receiver off "$ZWAVE_TTY" "$DIR/probe-rf-off-$mode.err" "$QUICK_TRIES" "$QUICK_PAUSE"; then
      ok "the receiver is off right after the $mode pass (try $ZR_RF_TRY)"
    else warn "the receiver did not answer 'off' right after the $mode pass ($(grep -E 'FAIL' "$DIR/probe-rf-off-$mode.err" | head -1 | cut -c1-100)) \
— it is tried again when this write ends, whichever way"; fi
    podman logs "$CT" > "$DIR/zui-$mode.log" 2>&1; podman rm -f "$CT" >/dev/null 2>&1; IN_PASS=0
    ok "container $CT stopped and removed (no driver restart on the restored image); \
its log: $DIR/zui-$mode.log ($(wc -l < "$DIR/zui-$mode.log" | tr -d ' ') lines)"
    [ "$rc" = 0 ] || { bad "the $mode pass did not succeed (rc $rc) — read its lines above and $DIR/zui-$mode.log"; exit 1; }
    sleep 1
  }
  zw_read() { # zw_read [--soft-reset]: the stick by serial, into V (the record's JSON) and got_home/got_nodes/got_region/got_power
    local try out parsed
    for try in $(seq 1 "$READ_TRIES"); do
      out=$(python3 "$PROBE" --zwave "$ZWAVE_TTY" "$@" --json 2>"$DIR/probe.err")
      # one python for the five values: V, then home ID, nodes, region, power (empty when missing); exit 0 = the read was ok
      parsed=$(printf '%s' "$out" | python3 -c 'import json, sys
try: z = json.load(sys.stdin).get("zwave") or {}
except ValueError: z = {}
rf = z.get("rf") or {}
v = {"ok": z.get("ok"), "home_id_hex": z.get("home_id_hex"), "node_count": z.get("node_count"),
     "rf_region": rf.get("region"), "tx_power_dbm": rf.get("tx_power_dbm"), "sdk": z.get("sdk"), "error": z.get("error")}
power = v["tx_power_dbm"]
print(json.dumps(v))
for x in (v["home_id_hex"], v["node_count"], v["rf_region"], None if power is None else "%g" % power): print("" if x is None else x)
sys.exit(0 if z.get("ok") else 1)') && break
      [ "$try" = "$READ_TRIES" ] && break
      warn "serial read $try: $(grep FAIL "$DIR/probe.err" | head -1 | cut -c1-120) — $READ_PAUSE s, again"; sleep "$READ_PAUSE"
    done
    grep -E "NOTE|FAIL" "$DIR/probe.err" | sed 's/^/    /'
    { read -r V; read -r got_home; read -r got_nodes; read -r got_region; read -r got_power; } <<<"$parsed"
  }
  same_home() { [ "${got_home,,}" = "${ZW_HOME,,}" ] && [ "$got_nodes" = "$ZW_NODES" ]; }
  rf_right() { [ "$got_region" = "$EXPECT_REGION" ] && [ "$got_power" = "$EXPECT_POWER" ]; }
  # another set than the last one written (a day's routes, a device added): both passes run even when the home ID
  # already matches — the stick must hold THIS set; the same set id = resume where the last run stopped
  # (No record, or one that names no Z-Wave set — a rebuilt VM with its old stick, a Zigbee-only write before: what
  # the stick answers says nothing about whose routes and nodes it holds. Both passes then, too.)
  # A write that was stopped between its passes is resumed: the set whose write began here is noted before the first
  # pass, and a re-run of that same set skips a pass whose result already holds.
  BEGAN_F="$STATE/restore-began-zwave"
  NEW_SET=$(fetch sets.zwave); LAST_SET=$(zr_json "$STATE/last-restore.json" fetch.sets.zwave); BEGAN=$(cat "$BEGAN_F" 2>/dev/null)
  FORCE=""
  if [ "$LAST_SET" = "$NEW_SET" ] || [ "$BEGAN" = "$NEW_SET" ]; then :      # this set, written or begun here
  elif [ -z "$LAST_SET" ] && [ -z "$BEGAN" ]; then
    FORCE=--force; warn "no record that this set was written here ($NEW_SET): both passes run (--force), whatever the stick answers"
  else
    FORCE=--force; warn "another set than the last one written (${LAST_SET:-$BEGAN} → $NEW_SET): both passes run (--force)"
  fi
  echo "$NEW_SET" > "$BEGAN_F"
  [ $FORCE_ARG = 1 ] && [ -z "$FORCE" ] && { FORCE=--force; warn "--force: both passes run whatever the stick holds"; }
  zw_read
  if [ -z "$FORCE" ] && same_home; then ok "the stick already holds home ID $got_home with $got_nodes nodes — the converting pass is skipped"
  else
    zw_pass converting $FORCE
    zw_read --soft-reset
    if same_home; then ok "after the converting pass + SoftReset: home ID $got_home with $got_nodes nodes (serial read, no driver)"
    else bad "after the converting pass the stick reads home ID '$got_home' with '$got_nodes' nodes — expected $ZW_HOME with $ZW_NODES"; exit 1; fi
  fi
  if [ -z "$FORCE" ] && rf_right; then ok "RF region $got_region at $got_power dBm already — the raw pass is skipped"
  else
    rf_right || warn "RF before the raw pass: region '$got_region' at '$got_power' dBm \
(the converting pass can rewrite a stick's RF config; the raw pass repairs it)"
    zw_pass raw --force
    zw_read --soft-reset
    if same_home && rf_right; then ok "after the raw pass + SoftReset: home ID $got_home with $got_nodes nodes, RF region $got_region at $got_power dBm"
    else bad "after the raw pass the stick reads home ID '$got_home', '$got_nodes' nodes, RF '$got_region' at '$got_power' dBm \
— expected $ZW_HOME / $ZW_NODES / $EXPECT_REGION at $EXPECT_POWER"; exit 1; fi
  fi
  record zwave "$V"
  # the written copy stays powered: its receiver OFF (it would ACK the live mesh's frames)
  if zr_receiver off "$ZWAVE_TTY" "$DIR/probe-rf-off.err" 1; then
    ok "the stick's RF receiver is off until its next power-up (a powered copy must not ACK the live mesh)"
  else warn "could not switch the stick's RF receiver off ($(grep -E 'FAIL' "$DIR/probe-rf-off.err" | head -1 | cut -c1-120)) \
— zradio-serve down tries again next"; fi
  [ $FAILS -eq 0 ] || exit 1
fi

if want zigbee; then
  echo "== 3. Zigbee: zigpy restore onto the coordinator =="
  # (--foreground: zigpy stays in this writer's process group. zradio-sync puts a time limit around the whole writer
  # and ends its group; a timeout without the option makes a group of its own, and zigpy would go on restoring a
  # coordinator that zradio-sync silences the next moment.)
  if timeout --foreground -k 10 "$ZIGPY_TIMEOUT" "$ZIGPY" radio znp "$ZIGBEE_TTY" restore "$DIR/zha-backup-restore.json" >"$DIR/zigpy-restore.log" 2>&1; then
    done_ "zigpy restore done ($(wc -l < "$DIR/zigpy-restore.log" | tr -d ' ') log lines kept in $DIR, not shown — they can hold key material)"
  else bad "zigpy restore failed (rc $?): $(grep -viE 'key' "$DIR/zigpy-restore.log" | tail -3 | tr '\n' ' ')"; exit 1; fi
  INFO=$(timeout --foreground -k 10 "$ZIGPY_TIMEOUT" "$ZIGPY" radio znp "$ZIGBEE_TTY" info 2>/dev/null)      # (it holds the network key: never printed)
  info_field() { # info_field <name>: a "Name: value" line of zigpy's info, lower case (the IEEE holds colons: up to the first one)
    printf '%s\n' "$INFO" | awk -v k="$1" 'tolower($0) ~ "^" k ":" {sub(/^[^:]*:[ \t]*/, ""); print tolower($0); exit}'
  }
  got_ieee=$(info_field "device ieee"); got_pan=$(info_field "pan id"); got_ch=$(info_field "channel")
  norm() { printf '%s' "${1,,}" | sed 's/^0x//'; }
  if [ "$(norm "$got_ieee")" = "$(norm "$ZB_IEEE")" ] && [ "$(norm "$got_pan")" = "$(norm "$ZB_PAN")" ] && [ "$got_ch" = "$ZB_CH" ]; then
    ok "the coordinator reads IEEE $got_ieee, PAN $got_pan, channel $got_ch (== the set)"
  else bad "the coordinator reads IEEE '$got_ieee', PAN '$got_pan', channel '$got_ch' — expected $ZB_IEEE / $ZB_PAN / $ZB_CH"; fi
  # the frame counter that was written (the active's, raised): a coordinator that came back with a lower one would
  # be ignored by every device that has seen a higher one, the day it takes over
  want_fc=$(fetch bump.to); got_fc=$(info_field "network key counter")
  if [[ ! "$got_fc" =~ ^[0-9]+$ ]] || [[ ! "$want_fc" =~ ^[0-9]+$ ]]; then warn "zigpy's info names no frame counter (or the set names none): the counter that was written ($want_fc) was not read back"
  elif [ "$got_fc" -ge "$want_fc" ]; then ok "the coordinator's frame counter reads $got_fc (written: $want_fc)"
  else bad "the coordinator's frame counter reads $got_fc, below the $want_fc that was written"; fi
  record zigbee "$(python3 -c 'import json, sys; print(json.dumps(dict(zip(("ieee", "pan_id", "channel"), sys.argv[1:]))))' "$got_ieee" "$got_pan" "$got_ch")"
  [ $FAILS -eq 0 ] || exit 1
fi

cp -f "$REC" "$STATE/last-restore.json"
find "$STATE" -maxdepth 1 -name 'restore-*.json' -mtime +"$KEEP_DAYS" -delete 2>/dev/null || true
echo "== done: written and verified from the set in $DIR — record $STATE/last-restore.json; the caller puts the sticks to silent standby next =="
exit 0
