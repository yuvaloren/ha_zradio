#!/usr/bin/env bash
# zradio-sync — keeps the STANDBY radio VM's sticks a copy of the ACTIVE's. Runs INSIDE each radio VM as root, installed
# at /usr/local/sbin/zradio-sync on both; the two VMs talk by ssh with one key that may run nothing but
# `zradio-sync serve-ssh` on the other side. No host, no NAS and no Home Assistant is part of it.
#
# What is synced: the radios that are "synced" in /etc/zradio/radios.conf on BOTH VMs, with the same family (the
# standby says what it has in its hello). Today that is a Z-Wave 800-series stick (NVM read / restore) and a TI Z-Stack
# coordinator (zigpy's open coordinator backup). A "served" radio is never read or written here.
#
#   zradio-sync run [--only zwave|zigbee] [--reason TEXT] [--rehearse]
#       on the ACTIVE (ser2net active, keepalived's last word MASTER): one sync —
#         1. ask the standby (hello): reachable, not serving. Not reachable = nothing is read (no pause for nothing).
#         2. read, holding the sticks lock: ser2net stopped; both sticks at once (Z-Wave: receiver off, NVM read;
#            Zigbee: zigpy's backup); then, as keepalived's last word says, the receiver on and ser2net started again
#            — or, if this VM lost the role meanwhile, the sticks left silent. The one pause Home Assistant sees
#            [V reference pair 2026-11-11: NVM read 6.7 s, zigpy backup 11.7 s]. A receiver that does not come back
#            on = $RUN/serve-failed: keepalived hands the role to the standby.
#         3. send + apply: manifest.json + the two files over ssh into the standby's `receive`, which writes them onto
#            its sticks (zradio-apply; the Zigbee frame counter raised by $BUMP), verifies both identities, silences
#            the sticks again (zradio-serve down) and answers SYNCED. Retried ($RETRY_PAUSES s) without a second read.
#         4. the record: $STATE/last-sync.json. A sync that did not end in SYNCED leaves $STATE/sync-pending.json and
#            the read set (0700, under $SECRETS/out): `tick` sends it again.
#       On a VM that is not the active: exit 0, nothing done (the timers run on both).
#       --rehearse: on a VM that does NOT serve — its own sticks are read and left silent; for a build's proof on the
#            standby with ZRADIO_SYNC_PEER pointed at itself. Refused on a VM that serves.
#   zradio-sync tick     every 15 min by timer. Active: the standby does not hold this VM's last sync (a failed sync, a
#                       takeover, a rebuilt standby) -> run; after a failed attempt the next waits 15 min, doubling,
#                       6 h at most (each read is a pause for Home Assistant). Standby: a set not written to the end
#                       (standby-dirty) -> reapply; a read set or pending mark left from an earlier turn as the active
#                       is dropped; the sticks are hushed (zradio-serve hush).
#   zradio-sync reapply  standby: write the last received set again
#   zradio-sync hello    one line: name, role, serving, the set this VM holds, dirty, and its radios' levels
#   zradio-sync beat     the same facts as one journal line, `zradio: event=state …`, every minute by timer on both
#                       VMs: what monitoring counts ("no active", "both active", "the standby is not ready").
#                       It is also where this VM's version advances: Home Assistant connected in a confirmed turn,
#                       and the peer — asked first — not ahead. `beat --quiet`: that check without the journal line
#                       (zradio-gate runs it every few seconds while a turn is not used yet).
#   zradio-sync peer-hello   the other VM's hello line, over the sync's ssh (zradio-switch asks with it)
#   zradio-sync status   the records, readable
#   zradio-sync keys     make this VM's sync key if missing; print its PUBLIC half and this VM's ssh host key
#   zradio-sync trust --sync-key 'ssh-ed25519 AAAA…' --host-key 'ssh-ed25519 AAAA…' [--peer ADDR]
#                       the peer's two public keys: its host key pinned for PEER, its sync key allowed to run
#                       `zradio-sync serve-ssh` from PEER and nothing else (authorized_keys: command=, from=, restrict)
#   zradio-sync serve-ssh   the forced command: hello | receive | poke | yield <term> <used> (from
#                       SSH_ORIGINAL_COMMAND); anything else is refused
#   zradio-sync peer-poke   ask the serving peer to run its tick now (a returning standby wants its sync at once)
#   zradio-sync peer-yield  ask the serving peer to hand the radios over: only honored when this VM's version is
#                       strictly higher than the peer's and ELECTION=act; the peer answers YIELDED
#   zradio-sync self-raise --above N   on a VM that does not serve: raise this VM's own Zigbee frame counter above N
#                       (its own backup, the counter set to max(read, N) + $BUMP, written back and verified by
#                       zradio-apply) — before an older copy, or a copy returning after an older one served, goes on
#                       the air: devices drop frames whose counter is below one they have already seen
#
# The version (docs/DESIGN.md, "Who serves when it is not obvious"): $STATE/version holds `term=N used=yes|no`. A sync
# carries the active's term to the standby (used=no). `beat` raises the term by one when Home Assistant is connected
# to a VM in a confirmed serving turn that has not been counted yet. In ELECTION=act a set with a lower term than this
# VM's is refused.
# Locks, always taken in this order: sync-out.lock (one run at a time) or sync-in.lock (one write at a time), then the
# sticks lock (zradio-common.sh). The read holds the sticks lock throughout; a standby's write takes it only to mark
# itself (applying, standby-dirty) on a VM that does not serve — zradio-serve up and hush look at those marks under it.
#
# What never happens: a set applied on a VM that serves; a set older than the one the standby holds; a key, an NVM byte
# or the Zigbee network key on stdout or in the journal. The Zigbee counter: the standby's copy starts $BUMP frames
# above the active's reading [V reference network, 11 nightly copies: the live counter grew 20–30 thousand a day].
# Journal lines: `zradio: event=sync result=…` (the active) and `event=sync-apply result=…` (the standby).
# Tests: tests/t-sync.sh. Env: ZRADIO_SYNC_*, ZRADIO_CONF, ZRADIO_RADIOS.
set -uo pipefail
LIB=${ZRADIO_LIB:-$(cd "$(dirname "$0")/../lib" 2>/dev/null && pwd)}; [ -r "$LIB/zradio-common.sh" ] || LIB=/usr/local/lib/zradio
# shellcheck source=../lib/zradio-common.sh
. "$LIB/zradio-common.sh" || exit 2
KEYF=${ZRADIO_SYNC_KEY:-/etc/zradio/sync.key}
KNOWN=${ZRADIO_SYNC_KNOWN:-/etc/zradio/sync.known_hosts}
AUTH=${ZRADIO_SYNC_AUTH:-/root/.ssh/authorized_keys}
HOSTKEY=${ZRADIO_SYNC_HOSTKEY:-/etc/ssh/ssh_host_ed25519_key.pub}
SECRETS=${ZRADIO_SYNC_SECRETS:-/etc/zradio/.secrets/sync}
STATE=${ZRADIO_SYNC_STATE:-/var/lib/zradio}
RUN=${ZRADIO_SYNC_RUN:-/run/zradio}
PROBE=${ZRADIO_SYNC_PROBE:-$LIB/zradio-probe.py}
ZIGPY=${ZRADIO_SYNC_ZIGPY:-/opt/zradio/zigpy/bin/zigpy}
RESTORE=${ZRADIO_SYNC_RESTORE:-/usr/local/sbin/zradio-apply}
SERVE=${ZRADIO_SYNC_SERVE:-/usr/local/sbin/zradio-serve}
SELFCMD=${ZRADIO_SYNC_SELFCMD:-/usr/local/sbin/zradio-sync}
SYSTEMCTL=${ZRADIO_SYNC_SYSTEMCTL:-systemctl}
SWITCH=${ZRADIO_SYNC_SWITCH:-/usr/local/sbin/zradio-switch}
SS=${ZRADIO_SYNC_SS:-ss}
SSH=${ZRADIO_SYNC_SSH:-ssh}
LOGGER=${ZRADIO_SYNC_LOGGER:-logger}
BUMP=${ZRADIO_SYNC_BUMP:-1000000}
RETRY_PAUSES=${ZRADIO_SYNC_RETRY_PAUSES:-30 120}
KEEP_S=${ZRADIO_SYNC_KEEP_S:-72000}        # a read set is sent again for 20 h; older = read again
ZR_RF_TRIES=${ZRADIO_SYNC_TRIES:-$ZR_RF_TRIES}; ZR_RF_PAUSE=${ZRADIO_SYNC_PAUSE:-$ZR_RF_PAUSE}
APPLY_TIMEOUT=${ZRADIO_SYNC_APPLY_TIMEOUT:-420}   # s for the standby's whole write [V: 90–97 s for both networks]
READ_TIMEOUT=90           # s for one stick's read (the NVM read, zigpy's backup) [V: 6.7 s and 11.7 s]
NVM_BUDGET=300            # s the probe may spend on the NVM read's commands, inside READ_TIMEOUT's bound
HELLO_TIMEOUT=15          # s for a hello / poke over ssh
BEAT_TIMEOUT=10           # s for beat's hello (it runs every few seconds from zradio-gate)
YIELD_TIMEOUT=90          # s for the peer's handover (zradio-switch there waits 20 s for this VM to serve)
RETRY_FIRST=900           # s: a failed sync's next try waits 15 min (each read is a pause for Home Assistant) …
RETRY_MAX=21600           # … doubling, 6 h at most
TICK_EARLY=60             # s a tick may come before its 15 minutes (the timer's accuracy) and still count
OUTD="$SECRETS/out"; IND="$SECRETS/in"
PENDING="$STATE/sync-pending.json"; LAST="$STATE/last-sync.json"; SYNCED="$STATE/synced.json"
FLOOR_F="$STATE/counter-floor"            # the highest Zigbee frame counter this VM's stick is known to have used
zr_markers

load_conf() { # the pair's conf and this VM's radios; ZW / ZB = the ttys
  zr_load_conf || { echo "zradio-sync: $ZR_ERR" >&2; exit 2; }
  PEER=${ZRADIO_SYNC_PEER:-$PEER}
  zr_load_radios || true          # no radios.conf = both "none": nothing here is synced, hello says so
  ZW=${ZRADIO_SYNC_ZWAVE_TTY:-$ZWAVE_TTY}
  ZB=${ZRADIO_SYNC_ZIGBEE_TTY:-$ZIGBEE_TTY}
  zr_version_read "$STATE"
}
log() { zr_say "$@"; }                    # log <event> <result> <text>: on stdout and in the journal
floor() { local f; f=$(cat "$FLOOR_F" 2>/dev/null); [[ "$f" =~ ^[0-9]{1,10}$ ]] && echo "$f" || echo 0; }
set_floor() { [[ "$1" =~ ^[0-9]{1,10}$ ]] && [ "$1" -gt "$(floor)" ] && { mkdir -p "$STATE"; echo "$1" > "$FLOOR_F"; }; return 0; }
client_state() { # yes | no | unknown: does Home Assistant hold a connection to one of the sticks' ports?
  local out
  zr_serving || { echo no; return; }
  out=$("$SS" -Htn state established "( sport = :$ZWAVE_PORT or sport = :$ZIGBEE_PORT )" 2>/dev/null) || { echo unknown; return; }
  [ -n "$out" ] && echo yes || echo no
}
client_connected() { [ "$(client_state)" = yes ]; }
synced_here() { # the kinds this VM can sync, as "zwave:<family> zigbee:<family>" words (the family is part of the match)
  local out=""
  zr_has zwave synced && out="zwave:${ZWAVE_FAMILY:-?}"
  zr_has zigbee synced && out="${out:+$out }zigbee:${ZIGBEE_FAMILY:-?}"
  printf '%s' "$out"
}
now() { printf '%s' "${EPOCHREALTIME:-$(date +%s)}"; }
since() { awk -v a="$1" -v b="$(now)" 'BEGIN { printf "%.1f", b - a }'; }
master_or_serving() { zr_serving || [ "$(zr_role)" = MASTER ]; }
is_active() { zr_serving && [ "$(zr_role)" = MASTER ]; }
in_set() { [ -z "$2" ] || [ "$2" = "$1" ]; }       # in_set <kind> <only|"">: that network is part of this set
first_fail() { grep -E 'FAIL' "$1" 2>/dev/null | head -1 | cut -c1-120; }
peer_ssh() { # peer_ssh <timeout s> <remote command>: stdin passes through
  [ -n "$PEER" ] || { echo "zradio-sync: no peer yet (PEER is not set in $ZR_CONF: the pair's other VM is not installed)" >&2; return 255; }
  timeout "$1" "$SSH" -i "$KEYF" -o IdentitiesOnly=yes -o BatchMode=yes -o StrictHostKeyChecking=yes \
    -o UserKnownHostsFile="$KNOWN" -o GlobalKnownHostsFile=/dev/null -o ConnectTimeout=5 \
    -o ServerAliveInterval=15 -o ServerAliveCountMax=4 -b "$SELF" "root@$PEER" "$2"
}

# ---------------------------------------------------------------- the Python half: the sets and the records
syncpy() { # syncpy <mode> <args…>: one place for what is easier in Python; a check that fails prints "BAD <why>", exit 1
  #   prep <dir> <bump>                     the received set checked; fetch.json + zha-backup-restore.json written.
  #                                         stdout "gen=… only=… term=… floor=… id=…"
  #   manifest <dir> <gen> <only> <reason> <pause_s> <name> <term>   the read set checked; manifest.json; stdout the ids
  #   raise <dir> <above> <bump>            this VM's own backup with its counter raised; stdout "from=… to=…"
  #   applied <file> <gen> <only> <id> <secs>                         the standby's record (synced.json)
  #   sent <file> <gen> <reason> <peer> <pause_s> <total_s> <tries> <answer>   the active's record (last-sync.json)
  #   pending <file> <gen> <why> <count: 1|0>                          a sync not confirmed yet (sync-pending.json)
  python3 - "$@" <<'PY'
import hashlib, json, os, re, sys, time
FORMAT = "zradio sync v1"
COUNTER_MAX = 0xFFFFFFFF          # a Zigbee frame counter is 32 bits
NVM_MIN = 4096                    # bytes: no 700/800-series NVM image is smaller
SET_FILES = {"manifest.json", "zwave-nvm.bin", "zha-backup.json", "zha-backup-restore.json", "fetch.json"}

def bad(why): print("BAD " + why); sys.exit(1)
def utc(): return time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime())
def sha(d, n):
    with open(os.path.join(d, n), "rb") as f: return hashlib.sha256(f.read()).hexdigest()
def load(path, what):
    try:
        with open(path) as f: return json.load(f)
    except Exception as e: bad("%s: %s" % (what, type(e).__name__))
def write_private(path, obj, indent=None):      # 0600: a set's files can hold key material
    with os.fdopen(os.open(path, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600), "w") as f: json.dump(obj, f, indent=indent)
def write_record(path, rec):                    # a record replaced at once, never half-written
    os.makedirs(os.path.dirname(path), exist_ok=True)
    with open(path + ".tmp", "w") as f: json.dump(rec, f, indent=1)
    os.replace(path + ".tmp", path)
def old_record(path):
    try:
        with open(path) as f: return json.load(f)
    except Exception: return {}

def zigbee_network(j, what):
    """A zigpy open-coordinator backup's network: (ieee aa:bb:…, pan, channel, key, frame counter), or BAD."""
    nk = j.get("network_key") or {}
    ieee = str(j.get("coordinator_ieee") or "").lower(); pan = str(j.get("pan_id") or "").lower(); ch = j.get("channel")
    key, fc = str(nk.get("key") or ""), nk.get("frame_counter")
    if not re.fullmatch(r"[0-9a-f]{16}", ieee) or not re.fullmatch(r"[0-9a-f]{4}", pan) or not isinstance(ch, int):
        bad(what + " holds no network identity")
    if not isinstance(fc, int) or fc < 0 or not re.fullmatch(r"[0-9a-fA-F]{32}", key):
        bad(what + " holds no network key / frame counter")
    return ":".join(ieee[i:i + 2] for i in range(0, 16, 2)), pan, ch, key, fc

def on_a_network(key, pan): return not set(key.lower()) <= {"0"} and pan not in ("ffff", "fffe")

def raise_counter(j, start, bump):
    """The backup's frame counter set to start + bump; BAD when that leaves no room under the 32-bit limit."""
    to = start + bump
    if to > COUNTER_MAX - bump: bad("the Zigbee frame counter %d leaves no room for the raise" % start)
    j["network_key"]["frame_counter"] = to
    return to

def prep(d, bump):
    bump = int(bump)
    names = set(os.listdir(d))
    if names - SET_FILES: bad("unexpected file(s) in the set: " + ", ".join(sorted(names - SET_FILES))[:120])
    for n in names:
        p = os.path.join(d, n)
        if os.path.islink(p) or not os.path.isfile(p): bad("%s is not a regular file" % n)
    m = load(os.path.join(d, "manifest.json"), "manifest.json")
    if m.get("format") != FORMAT: bad("manifest format %r" % m.get("format"))
    gen = str(m.get("gen") or "")
    if not re.fullmatch(r"\d{8}T\d{6}Z", gen): bad("gen %r" % gen)
    term = m.get("term", 0)
    if not isinstance(term, int) or isinstance(term, bool) or not 0 <= term < 10**9: bad("term %r" % term)
    only = m.get("only") or ""
    if only not in ("", "zwave", "zigbee"): bad("only %r" % only)
    fetch = {"format": FORMAT, "sets": {}, "identities": {}}
    ident = []
    if only in ("", "zwave"):
        z = m.get("zwave") or {}
        if "zwave-nvm.bin" not in names: bad("no zwave-nvm.bin")
        if sha(d, "zwave-nvm.bin") != z.get("sha256"): bad("zwave-nvm.bin does not match the manifest's sha256")
        if not re.fullmatch(r"0x[0-9a-fA-F]{8}", str(z.get("home_id") or "")) or not isinstance(z.get("nodes"), int) or z["nodes"] < 1:
            bad("Z-Wave identity in the manifest")
        if not isinstance(z.get("rf_region"), int) or not isinstance(z.get("tx_power_dbm"), (int, float)): bad("Z-Wave RF config in the manifest")
        home = z["home_id"].lower()
        fetch["sets"]["zwave"] = "sync-" + gen
        fetch["identities"]["zwave"] = {"home_id": home, "nodes": z["nodes"], "rf_region": z["rf_region"], "tx_power_dbm": z["tx_power_dbm"]}
        ident.append("zwave=%s/%d" % (home, z["nodes"]))
    if only in ("", "zigbee"):
        b = m.get("zigbee") or {}
        if "zha-backup.json" not in names: bad("no zha-backup.json")
        if sha(d, "zha-backup.json") != b.get("sha256"): bad("zha-backup.json does not match the manifest's sha256")
        j = load(os.path.join(d, "zha-backup.json"), "zha-backup.json")
        ieee, pan, ch, _, fc = zigbee_network(j, "zha-backup.json")
        if (b.get("ieee"), str(b.get("pan_id")).lower(), b.get("channel")) != (ieee, pan, ch): bad("the manifest's Zigbee identity is not the backup's")
        to = raise_counter(j, fc, bump)
        write_private(os.path.join(d, "zha-backup-restore.json"), j)
        fetch["sets"]["zigbee"] = "sync-" + gen
        fetch["identities"]["zigbee"] = {"ieee": ieee, "channel": ch, "pan_id": pan}
        fetch["bump"] = {"from": fc, "to": to, "how": "zradio-sync: the active's reading + %d" % bump}
        ident.append("zigbee=%s/%s/%d counter=%d" % (ieee, pan, ch, to))
    write_private(os.path.join(d, "fetch.json"), fetch, indent=1)
    print("gen=%s only=%s term=%d floor=%d id=%s" % (gen, only or "both", term, (fetch.get("bump") or {}).get("to", 0),
                                                    ",".join(ident).replace(" ", ",")))

def manifest(d, gen, only, reason, pause, name, term):
    m = {"format": FORMAT, "gen": gen, "from": name, "reason": reason, "only": only, "pause_s": float(pause), "term": int(term)}
    ident = []
    if only in ("", "zwave"):
        z = load(os.path.join(d, "zw-probe.json"), "the probe's JSON").get("zwave") or {}
        dump = z.get("nvm_dump") or {}; rf = z.get("rf") or {}
        p = os.path.join(d, "zwave-nvm.bin")
        size = os.path.getsize(p) if os.path.isfile(p) else 0
        if not z.get("ok") or not re.fullmatch(r"0x[0-9a-fA-F]{8}", str(z.get("home_id_hex") or "")) or not isinstance(z.get("node_count"), int):
            bad("the Z-Wave read gave no identity")
        if size < NVM_MIN or dump.get("bytes") != size or dump.get("size") != size:
            bad("the NVM read is short: %s of %s bytes" % (dump.get("bytes"), dump.get("size")))
        if not isinstance(rf.get("region"), int) or not isinstance(rf.get("tx_power_dbm"), (int, float)): bad("the Z-Wave read gave no RF config")
        m["zwave"] = {"home_id": z["home_id_hex"].lower(), "nodes": z["node_count"], "rf_region": rf["region"],
                      "tx_power_dbm": rf["tx_power_dbm"], "bytes": size, "sha256": sha(d, "zwave-nvm.bin")}
        ident.append("zwave=%s/%d" % (m["zwave"]["home_id"], m["zwave"]["nodes"]))
    if only in ("", "zigbee"):
        j = load(os.path.join(d, "zha-backup.json"), "zigpy's backup")
        ieee, pan, ch, key, fc = zigbee_network(j, "zigpy's backup")
        if not on_a_network(key, pan): bad("the coordinator is not on a network (blank key or PAN)")
        m["zigbee"] = {"ieee": ieee, "pan_id": pan, "channel": ch, "frame_counter": fc, "devices": len(j.get("devices") or []),
                       "sha256": sha(d, "zha-backup.json")}
        ident.append("zigbee=%s/%s/%d" % (ieee, pan, ch))
    write_private(os.path.join(d, "manifest.json"), m, indent=1)
    print(",".join(ident))

def raise_own(d, above, bump):
    above, bump = int(above), int(bump)
    j = load(os.path.join(d, "zha-backup.json"), "zigpy's backup")
    ieee, pan, ch, key, fc = zigbee_network(j, "this coordinator's backup")
    if not on_a_network(key, pan): bad("this coordinator is not on a network (nothing to raise)")
    to = raise_counter(j, max(fc, above), bump)
    write_private(os.path.join(d, "zha-backup-restore.json"), j)
    write_private(os.path.join(d, "fetch.json"), {"format": FORMAT, "sets": {"zigbee": "raise-%d" % to},
                  "identities": {"zigbee": {"ieee": ieee, "channel": ch, "pan_id": pan}},
                  "bump": {"from": fc, "to": to, "how": "zradio-sync self-raise --above %d" % above}})
    print("from=%d to=%d" % (fc, to))

def applied(p, gen, only, ident, secs):
    rec = {"gen": gen, "only": only, "identities": ident, "apply_s": float(secs), "applied_utc": utc(),
           "gens": dict(old_record(p).get("gens") or {})}
    for net in (("zwave", "zigbee") if only == "both" else (only,)): rec["gens"][net] = gen
    write_record(p, rec)

def sent(p, gen, reason, peer, pause, total, tries, answer):
    write_record(p, {"gen": gen, "reason": reason, "peer": peer, "pause_s": float(pause), "total_s": float(total),
                     "tries": int(tries), "answer": answer, "ok_utc": utc()})

def pending(p, gen, why, count):
    old = old_record(p)
    write_record(p, {"gen": gen, "why": why, "since_utc": old.get("since_utc") or utc(),
                     "attempts": int(old.get("attempts") or 0) + int(count)})

{"prep": prep, "manifest": manifest, "raise": raise_own, "applied": applied, "sent": sent, "pending": pending}[sys.argv[1]](*sys.argv[2:])
PY
}

# ---------------------------------------------------------------- the standby's side
hello_line() {
  local s=no d=no a=no w=no o=no g l t
  zr_serving && s=yes; [ -e "$DIRTY" ] && d=yes; [ -e "$APPLYING" ] && a=yes
  { [ -e "$BOOT_WAIT" ] || [ -e "$HOLD" ]; } && w=yes; [ -e "$OUTDATED" ] && o=yes
  g=$(zr_json "$SYNCED" gen); [ -n "$g" ] || g=none
  l=$(zr_json "$LAST" gen); [ -n "$l" ] || l=none
  t=$(cat "$TURN_F" 2>/dev/null); [ -n "$t" ] || t=none
  printf 'HELLO name=%s role=%s serving=%s gen=%s dirty=%s applying=%s zwave=%s zigbee=%s' "$NAME" "$(zr_role)" "$s" "$g" "$d" "$a" \
    "$ZWAVE${ZWAVE_FAMILY:+:$ZWAVE_FAMILY}" "$ZIGBEE${ZIGBEE_FAMILY:+:$ZIGBEE_FAMILY}"
  printf ' term=%s used=%s turn=%s client=%s outdated=%s wait=%s prio=%s zbfloor=%s last=%s\n' \
    "$ZR_TERM" "$ZR_USED" "$t" "$(client_state)" "$o" "$w" "$PRIORITY" "$(floor)" "$l"
}
mark_for_write() { # under the sticks lock, on a VM that does not serve: applying + standby-dirty. zradio-serve up and
  # hush look at these marks under the same lock, so neither can touch the sticks once the write has begun. WHY: a refusal
  zr_sticks_lock || { WHY="the sticks were held for more than $ZR_LOCK_WAIT s"; return 1; }
  if master_or_serving; then zr_sticks_unlock; WHY="this VM serves (ser2net active or MASTER)"; return 1; fi
  mkdir -p "$STATE" "$RUN"; : > "$DIRTY"; : > "$APPLYING"
  zr_sticks_unlock
}
apply_set() { # apply_set <dir> <gen> <only|both> <id> [term] [zigbee counter written]: onto this VM's sticks; the answer
  # is the last line on stdout
  local d=$1 gen=$2 only=$3 id=$4 term=${5:-} zfloor=${6:-0} t0 rc
  t0=$(now)
  if ! mark_for_write; then
    log sync-apply refused "gen=$gen — $WHY: nothing written" >&2; echo "REFUSED $WHY: nothing is written onto an active's sticks"; return 1
  fi
  local args=(--run --from "$d"); [ "$only" = both ] || args+=(--only "$only")
  bash "$RESTORE" "${args[@]}" > "$STATE/sync-apply.log" 2>&1; rc=$?
  if [ $rc != 0 ]; then
    rm -f "$APPLYING"
    log sync-apply failed "gen=$gen step=restore rc=$rc — $(grep -E '^FAIL' "$STATE/sync-apply.log" | head -1 | cut -c1-200) \
(log: $STATE/sync-apply.log; standby-dirty stays: this VM does not serve until a set is written to the end)" >&2
    echo "FAILED gen=$gen step=restore"; return 1
  fi
  if ! "$SERVE" down >> "$STATE/sync-apply.log" 2>&1; then
    rm -f "$APPLYING"
    log sync-apply failed "gen=$gen step=silence — zradio-serve down did not end clean after the restore \
(log: $STATE/sync-apply.log; standby-dirty stays)" >&2
    echo "FAILED gen=$gen step=silence"; return 1
  fi
  syncpy applied "$SYNCED" "$gen" "$only" "$id" "$(since "$t0")"
  rm -f "$DIRTY" "$APPLYING"
  # the copy is the active's: its term, not yet used here; whatever said this VM was behind is settled — both under
  # the version lock, so that zradio-gate never writes a decision made on the version before this one after it
  zr_version_lock || log sync-apply loud "gen=$gen — the version lock was held for more than $ZR_LOCK_WAIT s: written without it" >&2
  if [[ "$term" =~ ^[0-9]+$ ]]; then zr_version_write "$STATE" "$term" no; fi
  rm -f "$OUTDATED" "$HOLD" "$MAY_SERVE" "$ALONE"
  zr_version_unlock
  set_floor "$zfloor"
  rm -f "$d/zwave-nvm.bin" "$d/zha-backup.json" "$d/zha-backup-restore.json"   # written and verified: no image stays at rest
  log sync-apply ok "gen=$gen $id apply_s=$(since "$t0") — the sticks hold the set and are silent" >&2
  echo "SYNCED gen=$gen $id apply_s=$(since "$t0")"
}
drop_out() { rm -rf "$OUTD"; rm -f "$PENDING"; }   # a read set from an earlier turn as the active is never sent later
cmd_receive() {
  zr_need_root; mkdir -p "$RUN" "$IND"; chmod 700 "$SECRETS" "$IND" 2>/dev/null
  exec 8>"$RUN/sync-in.lock"; flock -n 8 || { echo "FAILED busy — another set is being applied"; exit 75; }
  if master_or_serving; then cat >/dev/null; echo "REFUSED this VM serves (ser2net active or MASTER): nothing is written onto an active's sticks"; exit 1; fi
  drop_out
  local tmp="$IND/incoming" p gen only id cur st k
  rm -rf "$tmp"; mkdir -m 700 "$tmp" || { echo "FAILED no $tmp"; exit 1; }
  ( umask 077; tar -C "$tmp" -xf - --no-same-owner --no-same-permissions ) 2>/dev/null || { rm -rf "$tmp"; echo "FAILED the stream was not a tar"; exit 1; }
  if ! p=$(syncpy prep "$tmp" "$BUMP"); then
    rm -rf "$tmp"; log sync-apply refused "${p:-the set did not check}" >&2; echo "REFUSED ${p:-the set did not check}"; exit 1
  fi
  gen=$(zr_field "$p" gen); only=$(zr_field "$p" only); id=$(zr_field "$p" id); st=$(zr_field "$p" term)
  if [ "$ELECTION" = act ] && [ "${st:-0}" -lt "$ZR_TERM" ]; then
    rm -rf "$tmp"
    log sync-apply refused "gen=$gen — the set is of term ${st:-0} and this VM holds term $ZR_TERM: an older copy is not written over a newer one" >&2
    echo "REFUSED older term: the set is term ${st:-0}, this VM holds $ZR_TERM"; exit 1
  fi
  [ "${st:-0}" -ge "$ZR_TERM" ] || log sync-apply would-refuse "gen=$gen — the set is of term ${st:-0} and this VM holds term $ZR_TERM: \
in act mode an older copy would not be written over a newer one (observe mode: it is)" >&2
  for k in zwave zigbee; do
    if { [ "$only" = both ] || [ "$only" = "$k" ]; } && ! zr_has "$k" synced; then
      rm -rf "$tmp"; log sync-apply refused "gen=$gen — the set holds a $k image and this VM has no synced $k stick (radios.conf)" >&2
      echo "REFUSED no synced $k stick here"; exit 1
    fi
  done
  cur=$(zr_json "$SYNCED" gen)
  if [ -n "$cur" ] && [[ "$gen" < "$cur" ]]; then rm -rf "$tmp"; echo "REFUSED stale: this VM holds $cur, the set is $gen"; exit 1; fi
  rm -rf "$IND/current"; mv "$tmp" "$IND/current"
  apply_set "$IND/current" "$gen" "$only" "$id" "$st" "$(zr_field "$p" floor)"
}
cmd_reapply() {
  zr_need_root; mkdir -p "$RUN"
  exec 8>"$RUN/sync-in.lock"; flock -n 8 || { echo "busy — a set is being applied"; exit 75; }
  if master_or_serving; then echo "REFUSED this VM serves"; exit 1; fi
  [ -f "$IND/current/manifest.json" ] || { echo "no received set under $IND/current — nothing to write again (the next sync brings one)"; exit 1; }
  local p; p=$(syncpy prep "$IND/current" "$BUMP") \
    || { echo "REFUSED ${p:-the kept set did not check} (a set written to the end keeps no image: only a set that failed can be written again)"; exit 1; }
  apply_set "$IND/current" "$(zr_field "$p" gen)" "$(zr_field "$p" only)" "$(zr_field "$p" id)" "$(zr_field "$p" term)" "$(zr_field "$p" floor)"
}

# ---------------------------------------------------------------- the active's side
STOPPED=0
resume_serving() { # the EXIT trap of a read that did not end (read_sticks resumes by itself): ser2net back if MASTER
  [ $STOPPED = 1 ] || return 0
  STOPPED=0
  [ "$(zr_role)" = MASTER ] || return 0
  "$SYSTEMCTL" start ser2net || { : > "$FAILED"; log sync loud "step=ser2net — ser2net did not start after the read: out of the election"; }
}
read_sticks() { # read_sticks <dir> <only|""> <live: 1|0> — the pause; sets PAUSE_S. The sticks lock is held throughout,
  # so the role is looked at once more at the end, and what the sticks are left as follows it: a change of role after
  # that look queues zradio-serve up or down behind the lock, and that one has the last word.
  local d=$1 only=$2 live=$3 t0 zrc=0 brc=0 zp="" bp=""
  rm -rf "$d"; mkdir -p "$d" && chmod 700 "$SECRETS" "$d" || return 1
  zr_sticks_lock || { log sync failed "step=lock — the sticks were held for more than $ZR_LOCK_WAIT s: nothing read"; return 1; }
  if [ "$live" = 1 ] && ! is_active; then
    zr_sticks_unlock; log sync failed "step=role — this VM gave the role up while it waited for the sticks: nothing read"; return 1
  fi
  if [ -e "$APPLYING" ]; then zr_sticks_unlock; log sync failed "step=applying — a set is being written onto these sticks: nothing read"; return 1; fi
  t0=$(now)
  if [ "$live" = 1 ]; then "$SYSTEMCTL" stop ser2net || true; STOPPED=1; fi
  if in_set zwave "$only"; then
    ( zr_receiver off "$ZW" "$d/rf-off.err" || { echo "the receiver did not answer 'off' ($(first_fail "$d/rf-off.err"))" > "$d/zwave.why"; exit 1; }
      ( cd "$d" && timeout "$READ_TIMEOUT" python3 "$PROBE" --zwave "$ZW" --budget "$NVM_BUDGET" --nvm-dump zwave-nvm.bin --json \
          > zw-probe.json 2> zw-probe.err ) || { echo "the NVM read failed ($(first_fail "$d/zw-probe.err"))" > "$d/zwave.why"; exit 1; }
    ) & zp=$!
  fi
  if in_set zigbee "$only"; then
    ( umask 077; timeout "$READ_TIMEOUT" "$ZIGPY" radio znp "$ZB" backup "$d/zha-backup.json" > "$d/zigpy-backup.log" 2>&1 ) & bp=$!
  fi
  [ -z "$zp" ] || wait "$zp" || zrc=1
  [ -z "$bp" ] || wait "$bp" || brc=1
  if [ $STOPPED = 1 ] && [ "$(zr_role)" = MASTER ]; then         # still the active (looked at once): serve again
    STOPPED=0
    if in_set zwave "$only" && ! zr_receiver on "$ZW" "$d/rf-on.err"; then
      : > "$FAILED"; zrc=1               # ser2net stays stopped: Home Assistant is not handed a deaf stick
      log sync loud "step=zwave-receiver — the receiver did not come back ON after the NVM read: this stick may be deaf; \
ser2net stays stopped, out of the election (serve-failed), the standby takes the role"
    elif ! "$SYSTEMCTL" start ser2net; then
      : > "$FAILED"; log sync loud "step=ser2net — ser2net did not start after the read: out of the election, the standby takes the role"
    fi
  else                                                             # a standby, or the active no more: silent
    if in_set zwave "$only" && ! zr_receiver off "$ZW" "$d/rf-off2.err"; then
      zrc=1; log sync loud "step=zwave-receiver — the receiver did not answer 'off' after the read: this stick may listen to the mesh"
    fi
    [ $STOPPED = 0 ] || log sync note "this VM lost the role during the read: ser2net is left stopped and the sticks silent"
    STOPPED=0
  fi
  zr_sticks_unlock
  PAUSE_S=$(since "$t0")
  [ $zrc = 0 ] || { log sync failed "step=read-zwave — $(cat "$d/zwave.why" 2>/dev/null || echo 'see the lines above') (pause ${PAUSE_S} s)"; return 1; }
  [ $brc = 0 ] || { log sync failed "step=read-zigbee — zigpy backup did not end clean (log kept in the read set, not shown; pause ${PAUSE_S} s)"; return 1; }
  return 0
}
send_set() { # send_set <dir>: tar over ssh into the peer's receive; ANSWER = its last line
  local d=$1 files=(manifest.json)
  [ -f "$d/zwave-nvm.bin" ] && files+=(zwave-nvm.bin); [ -f "$d/zha-backup.json" ] && files+=(zha-backup.json)
  ANSWER=$(tar -C "$d" -cf - "${files[@]}" | peer_ssh "$APPLY_TIMEOUT" receive 2>/dev/null | tail -1) || true
  case "$ANSWER" in SYNCED\ gen=*) return 0;; *) return 1;; esac
}
write_pending() { syncpy pending "$PENDING" "$1" "$2" "${3:-1}"; }   # <gen> <why> [count 1|0: 0 = it cost Home Assistant nothing]
cmd_run() {
  local only="" reason=manual rehearse=0
  while [ $# -gt 0 ]; do case "$1" in
    --only) only=$2; shift 2;; --reason) reason=$(printf '%s' "$2" | tr -c 'A-Za-z0-9_-' '_'); shift 2;; --rehearse) rehearse=1; shift;;
    *) echo "unknown arg: $1" >&2; exit 2;; esac; done
  case "$only" in ""|zwave|zigbee) ;; *) echo "die: --only zwave|zigbee" >&2; exit 2;; esac
  zr_need_root; mkdir -p "$RUN" "$STATE"
  HERE_SYNCED=$(synced_here)
  [ -n "$HERE_SYNCED" ] || { echo "no radio on this VM is at level 'synced' (radios.conf: zwave=$ZWAVE zigbee=$ZIGBEE) — nothing to sync"; exit 0; }
  if [ $rehearse = 1 ]; then
    if master_or_serving; then echo "REFUSED: --rehearse on a VM that serves (it reads the sticks without giving them back to Home Assistant)"; exit 1; fi
  elif ! is_active; then
    echo "not the active (ser2net $(zr_serving && echo active || echo 'not active'), keepalived's last word $(zr_role)) — nothing to do"; exit 0
  fi
  [ -n "$PEER" ] || { echo "no peer yet (PEER is not set in $ZR_CONF: the pair's other VM is not installed) — nothing to sync"; exit 0; }
  exec 9>"$RUN/sync-out.lock"; flock -n 9 || { echo "a sync is running already — nothing done"; exit 0; }
  [ -r "$KEYF" ] && [ -s "$KNOWN" ] || { log sync failed "step=keys — no $KEYF or no $KNOWN: the pair is not paired (zradio-sync keys / trust)"; exit 1; }
  local t0 h gen id tries=0 pause theirs
  t0=$(now)
  h=$(peer_ssh "$HELLO_TIMEOUT" hello 2>/dev/null | tail -1) || true
  case "$h" in HELLO\ *) ;; *)
    write_pending none "the standby did not answer" 0
    log sync failed "step=hello reason=$reason — the standby ($PEER) did not answer: nothing was read, Home Assistant saw no pause; tick tries again"
    exit 1;; esac
  if [ "$(zr_field "$h" serving)" = yes ] || [ "$(zr_field "$h" role)" = MASTER ]; then
    log sync failed "step=hello reason=$reason — the peer says it serves ($h): two actives; nothing read, nothing sent"; exit 1; fi
  # what can be synced: the kinds "synced" on both VMs with the same family
  local both="" k mine
  for k in zwave zigbee; do
    mine=$(printf '%s\n' "$HERE_SYNCED" | tr ' ' '\n' | sed -n "s/^$k://p")
    [ -n "$mine" ] && [ "$(zr_field "$h" "$k")" = "synced:$mine" ] && both="${both:+$both }$k"
  done
  theirs="here: ${HERE_SYNCED:-nothing}; the standby: zwave=$(zr_field "$h" zwave) zigbee=$(zr_field "$h" zigbee)"
  if [ -n "$only" ]; then
    case " $both " in *" $only "*) ;;
      *) log sync failed "step=radios reason=$reason — --only $only, but $only is not synced on both VMs ($theirs)"; exit 1;; esac
  else
    case "$both" in
      "zwave zigbee") only="";;
      zwave|zigbee) only=$both
        [ "$(printf '%s\n' "$HERE_SYNCED" | wc -w)" = 1 ] || log sync note "only $both is synced on both VMs ($theirs): the other network is not copied";;
      *) rm -f "$PENDING"
        log sync mismatch "reason=$reason — no radio is synced on both VMs with the same family ($theirs): nothing read, nothing sent"; exit 1;;
    esac
  fi
  # a read set kept from a sync that did not get through is sent again — the same networks, not older than $KEEP_S s
  gen=""
  if [ $rehearse = 0 ] && [ -f "$PENDING" ] && [ -f "$OUTD/manifest.json" ] && [ "$(zr_json "$OUTD/manifest.json" only)" = "$only" ] \
     && [ $(( $(date +%s) - $(stat -c %Y "$OUTD/manifest.json") )) -lt "$KEEP_S" ]; then
    gen=$(zr_json "$OUTD/manifest.json" gen); PAUSE_S=0; id="kept-set"
    log sync note "gen=$gen — the read set of the last attempt is sent again (no second read, no pause)"
  else
    gen=$(date -u +%Y%m%dT%H%M%SZ)
    trap 'resume_serving' EXIT
    if read_sticks "$OUTD" "$only" $((1 - rehearse)); then :; else write_pending "$gen" "the read failed"; exit 1; fi
    trap - EXIT
    id=$(syncpy manifest "$OUTD" "$gen" "$only" "$reason" "$PAUSE_S" "$NAME" "$ZR_TERM") || {
      write_pending "$gen" "the read did not check"
      log sync failed "step=check gen=$gen — ${id:-the read set did not check} (pause ${PAUSE_S} s)"; rm -rf "$OUTD"; exit 1; }
    set_floor "$(zr_json "$OUTD/manifest.json" zigbee.frame_counter)"     # this stick's own counter, as read just now
    rm -f "$OUTD"/zw-probe.json "$OUTD"/*.err "$OUTD"/zigpy-backup.log
    log sync note "gen=$gen reason=$reason read: $id pause_s=$PAUSE_S"
  fi
  write_pending "$gen" "sending"
  for pause in 0 $RETRY_PAUSES; do
    [ "$pause" = 0 ] || sleep "$pause"
    tries=$((tries + 1))
    if send_set "$OUTD"; then
      syncpy sent "$LAST" "$gen" "$reason" "$PEER" "$PAUSE_S" "$(since "$t0")" "$tries" "$ANSWER"
      rm -rf "$OUTD"; rm -f "$PENDING"
      log sync ok "gen=$gen reason=$reason pause_s=$PAUSE_S total_s=$(since "$t0") tries=$tries — the standby answered: $ANSWER"
      exit 0
    fi
    log sync retry "gen=$gen try=$tries — the standby answered: ${ANSWER:-nothing}"
    case "$ANSWER" in REFUSED*) break;; esac   # a refusal does not change by asking again
  done
  log sync failed "step=apply gen=$gen reason=$reason tries=$tries — not confirmed by the standby (last answer: ${ANSWER:-nothing}); \
the read set is kept, tick sends it again"
  exit 1
}
may_retry() { # 0 = a pending sync may be tried now: RETRY_FIRST after the first failed attempt, doubling, RETRY_MAX at most
  local a age wait
  a=$(zr_json "$PENDING" attempts); [[ "$a" =~ ^[0-9]+$ ]] || a=0
  [ "$a" -ge 1 ] || return 0
  age=$(( $(date +%s) - $(stat -c %Y "$PENDING" 2>/dev/null || echo 0) ))
  wait=$(( RETRY_FIRST << (a - 1 < 5 ? a - 1 : 5) )); [ "$wait" -le "$RETRY_MAX" ] || wait=$RETRY_MAX   # (the shift stops before it overflows)
  [ "$age" -ge $(( wait - TICK_EARLY )) ]
}
cmd_tick() {
  zr_need_root; mkdir -p "$RUN" "$STATE"
  zr_holds_self || log address loud "this VM does not hold its address $SELF any more (it holds ${ZR_HOLDS:-none}): the other VM cannot hear it, \
and it does not serve (zradio-serve check). An address from DHCP that changed: give this VM $SELF back (a reservation in the DHCP server), \
or pair the two again on the new one"
  if is_active; then
    local h mine
    [ -n "$(synced_here)" ] || { echo "no radio on this VM is at level 'synced' — nothing to sync"; exit 0; }
    h=$(peer_ssh "$HELLO_TIMEOUT" hello 2>/dev/null | tail -1) || true
    case "$h" in HELLO\ *) ;; *)
      [ -f "$PENDING" ] && log sync waiting "the standby ($PEER) does not answer and a sync is pending since $(zr_json "$PENDING" since_utc)"; exit 0;; esac
    mine=$(zr_json "$LAST" gen)
    if [ -f "$PENDING" ] || [ "$(zr_field "$h" dirty)" = yes ] || [ -z "$mine" ] || [ "$(zr_field "$h" gen)" != "$mine" ]; then
      if [ -f "$PENDING" ] && ! may_retry; then echo "a sync is pending (attempt $(zr_json "$PENDING" attempts)) — the next try waits its turn"; exit 0; fi
      exec "$SELFCMD" run --reason catch-up
    fi
    echo "the standby holds this VM's last sync ($mine) — nothing to do"; exit 0
  fi
  if master_or_serving; then echo "between roles (ser2net $(zr_serving && echo active || echo 'not active'), $(zr_role)) — nothing done"; exit 0; fi
  { [ -e "$OUTD" ] || [ -f "$PENDING" ]; } && { drop_out; echo "a read set / pending mark from an earlier turn as the active: dropped"; }
  if [ -e "$DIRTY" ] && [ ! -e "$APPLYING" ] && [ -f "$IND/current/manifest.json" ]; then exec "$SELFCMD" reapply; fi
  if [ ! -e "$APPLYING" ] && [ ! -e "$DIRTY" ]; then
    exec 8>"$RUN/sync-in.lock"; flock -n 8 || { echo "standby — a set is being written, nothing done"; exit 0; }
    "$SERVE" hush || true     # a stick that came back listening is silenced within one tick
  fi
  echo "standby — nothing else to do"; exit 0
}
cmd_beat() { # the state line (not with --quiet); and the term goes up once Home Assistant uses a confirmed turn
  if is_active && [ "$ZR_USED" = no ] && [ "$(cat "$TURN_F" 2>/dev/null)" = confirmed ] && client_connected; then
    # …but never past a peer that answers and is ahead: that is what a healed cut link looks like from the side Home
    # Assistant was NOT using (or an old active back before this VM was used). The peer's gate takes the radios back.
    local ph pk=-1 mk theirs; mk=$(zr_vkey "$ZR_TERM" "$ZR_USED")
    ph=$(peer_ssh "$BEAT_TIMEOUT" hello 2>/dev/null | tail -1) || true
    case "$ph" in HELLO\ *) pk=$(zr_vkey "$(zr_field "$ph" term)" "$(zr_field "$ph" used)");; esac
    theirs="term=$(zr_field "$ph" term) used=$(zr_field "$ph" used); this VM term=$ZR_TERM used=$ZR_USED"
    if [ "$pk" -gt "$mk" ] && [ "$ELECTION" = act ]; then
      echo provisional > "$TURN_F"
      log election behind "Home Assistant is connected here, but the peer answers and holds the newer networks ($theirs): \
this VM's version does not advance, its turn is provisional now, and the peer takes the radios back" >/dev/null
    else
      [ "$pk" -le "$mk" ] || log election would-behind "Home Assistant is connected here, and the peer answers and holds the newer \
networks ($theirs): in act mode this VM's version would not advance and the peer would take the radios back (observe mode: it advances)" >/dev/null
      zr_version_write "$STATE" $((ZR_TERM + 1)) yes && zr_version_read "$STATE"
      rm -f "$OUTDATED"                            # (an outdated VM in use IS the copy in use now)
      zr_log version advanced "term=$ZR_TERM — Home Assistant is connected in a confirmed turn: this VM's sticks are now the newest copy"
    fi
  fi
  [ "${1:-}" != --quiet ] || return 0            # zradio-gate's look every few seconds: no state line
  local h; h=$(hello_line); "$LOGGER" -t zradio "event=state ${h#HELLO }" 2>/dev/null || true; echo "$h"
}
cmd_yield() { # the forced command's `yield <term> <used>`: a more advanced VM asks this serving VM to hand over
  local rt=${1:-} ru=${2:-} mine theirs out
  [[ "$rt" =~ ^[0-9]{1,9}$ ]] && { [ "$ru" = yes ] || [ "$ru" = no ]; } || { echo "REFUSED yield wants <term> <yes|no>"; exit 1; }
  is_active || { echo "REFUSED this VM does not serve"; exit 1; }
  mine=$(zr_vkey "$ZR_TERM" "$ZR_USED"); theirs=$(zr_vkey "$rt" "$ru")
  [ "$theirs" -gt "$mine" ] || { echo "REFUSED not more advanced: yours term=$rt used=$ru, mine term=$ZR_TERM used=$ZR_USED"; exit 1; }
  if [ "$ELECTION" != act ]; then
    log election would-yield "the peer (term=$rt used=$ru) is ahead of this serving VM (term=$ZR_TERM used=$ZR_USED) and asked for the radios; \
observe mode: nothing is changed" >&2
    echo "REFUSED observe mode (ELECTION is not 'act')"; exit 1
  fi
  log election yield "the peer (term=$rt used=$ru) is ahead of this serving VM (term=$ZR_TERM used=$ZR_USED): handing the radios over" >&2
  if out=$("$SWITCH" --run --yield 2>&1); then echo "YIELDED"; exit 0; fi
  out=$(printf '%s' "$out" | grep -E '^FAIL' | head -1)
  log election loud "yield: the handover did not end clean: $(printf '%s' "$out" | cut -c1-200)" >&2
  echo "FAILED yield: $(printf '%s' "$out" | cut -c1-160)"; exit 1
}
cmd_self_raise() { # this VM's own Zigbee counter above N, on a VM that does not serve
  local above=""; while [ $# -gt 0 ]; do case "$1" in --above) above=$2; shift 2;; *) echo "unknown arg: $1" >&2; exit 2;; esac; done
  [[ "$above" =~ ^[0-9]{1,10}$ ]] || { echo "die: --above N" >&2; exit 2; }
  zr_need_root; mkdir -p "$RUN" "$STATE" "$IND"; chmod 700 "$SECRETS" "$IND" 2>/dev/null
  zr_has zigbee synced || { echo "no synced Zigbee stick here — nothing to raise"; exit 0; }
  if master_or_serving; then echo "REFUSED this VM serves: a counter is raised before serving, never under Home Assistant"; exit 1; fi
  exec 8>"$RUN/sync-in.lock"; flock -n 8 || { echo "busy — a set is being written"; exit 75; }
  local d="$IND/raise" p rc
  rm -rf "$d"; mkdir -m 700 "$d" || exit 1
  ( umask 077; timeout "$READ_TIMEOUT" "$ZIGPY" radio znp "$ZB" backup "$d/zha-backup.json" > "$d/zigpy-backup.log" 2>&1 ) \
    || { rm -rf "$d"; log election loud "self-raise: zigpy's backup of this VM's own coordinator did not end clean — the counter was not raised"; exit 1; }
  if ! p=$(syncpy raise "$d" "$above" "$BUMP"); then
    rm -rf "$d"; log election loud "self-raise: ${p:-the backup did not check} — the counter was not raised"; exit 1
  fi
  mark_for_write || { rm -rf "$d"; log election loud "self-raise: $WHY — the counter was not raised"; exit 1; }
  bash "$RESTORE" --run --only zigbee --from "$d" > "$STATE/self-raise.log" 2>&1; rc=$?
  if [ $rc = 0 ] && "$SERVE" down >> "$STATE/self-raise.log" 2>&1; then
    rm -f "$DIRTY" "$APPLYING"; set_floor "$(zr_field "$p" to)"; rm -rf "$d"
    log election raised "the Zigbee frame counter of this VM's own coordinator: $(zr_field "$p" from) → $(zr_field "$p" to) (above $above)"; exit 0
  fi
  rm -f "$APPLYING"
  log election loud "self-raise: writing the raised backup did not end clean (rc $rc; log: $STATE/self-raise.log; standby-dirty stays: \
this VM does not serve until a set is written to the end)"; exit 1
}
cmd_keys() {
  zr_need_root
  if [ ! -f "$KEYF" ]; then
    ( umask 077; mkdir -p "$(dirname "$KEYF")"; ssh-keygen -q -t ed25519 -N '' -C "zradio-sync@$NAME" -f "$KEYF" ) || { echo "ssh-keygen failed" >&2; exit 1; }
  fi
  printf 'SYNCKEY %s\n' "$(cut -d' ' -f1,2 < "$KEYF.pub")"
  printf 'HOSTKEY %s\n' "$(cut -d' ' -f1,2 < "$HOSTKEY")"
}
cmd_trust() {
  local sk="" hk="" peer=$PEER
  while [ $# -gt 0 ]; do case "$1" in --sync-key) sk=$2; shift 2;; --host-key) hk=$2; shift 2;; --peer) peer=$2; shift 2;;
    *) echo "unknown arg: $1" >&2; exit 2;; esac; done
  zr_need_root
  local re='^ssh-ed25519 [A-Za-z0-9+/=]{60,80}$'
  [[ "$sk" =~ $re ]] && [[ "$hk" =~ $re ]] \
    || { echo "die: --sync-key and --host-key are each 'ssh-ed25519 AAAA…' (two words, the public halves zradio-sync keys prints)" >&2; exit 2; }
  zr_ip4 "$peer" || { echo "die: --peer is the other radio VM's IPv4 address" >&2; exit 2; }
  ( umask 077; mkdir -p "$(dirname "$AUTH")" "$(dirname "$KNOWN")"; touch "$AUTH"
    printf '%s %s\n' "$peer" "$hk" > "$KNOWN.tmp" && mv -f "$KNOWN.tmp" "$KNOWN"
    { grep -v ' zradio-sync-peer$' "$AUTH" || true
      printf 'command="%s serve-ssh",from="%s",restrict %s zradio-sync-peer\n' "$SELFCMD" "$peer" "$sk"; } > "$AUTH.tmp" \
      && chmod 600 "$AUTH.tmp" && mv -f "$AUTH.tmp" "$AUTH" ) || { echo "trust: not written" >&2; exit 1; }
  chmod 644 "$KNOWN"
  echo "trusted: $peer's host key pinned in $KNOWN; its sync key may run '$SELFCMD serve-ssh' from $peer and nothing else ($AUTH)"
}
cmd_status() {
  hello_line
  for f in "$LAST" "$SYNCED" "$PENDING"; do [ -f "$f" ] && { echo "-- $f"; cat "$f"; echo; }; done
  [ -e "$DIRTY" ] && echo "-- $DIRTY: a set was not written to the end — this VM does not serve until one is"
  [ -e "$OUTD/manifest.json" ] && echo "-- a read set waits under $OUTD (gen $(zr_json "$OUTD/manifest.json" gen))"
  exit 0
}

MODE=${1:-}; [ $# -gt 0 ] && shift
case "$MODE" in
  -h|--help|"") sed -n '2,/^set -uo pipefail$/{/^set -uo pipefail$/!p}' "$0"; [ -n "$MODE" ] && exit 0 || exit 2;;
esac
load_conf
case "$MODE" in
  run) cmd_run "$@";;
  tick) cmd_tick;;
  reapply) cmd_reapply;;
  hello) hello_line;;
  beat) cmd_beat "${1:-}";;
  peer-hello) zr_need_root; peer_ssh "$HELLO_TIMEOUT" hello;;
  peer-poke) zr_need_root; peer_ssh "$HELLO_TIMEOUT" poke;;
  peer-yield) zr_need_root; peer_ssh "$YIELD_TIMEOUT" "yield $ZR_TERM $ZR_USED";;
  self-raise) cmd_self_raise "$@";;
  status) cmd_status;;
  keys) cmd_keys;;
  trust) cmd_trust "$@";;
  serve-ssh)
    case "${SSH_ORIGINAL_COMMAND:-}" in
      hello) hello_line;;
      receive) cmd_receive;;
      poke) if ! is_active; then echo "IGNORED this VM does not serve"
            else "$SYSTEMCTL" start --no-block zradio-sync-tick.service && echo "POKED the tick runs now"; fi;;
      yield\ *) read -r _ yt yu _ <<<"$SSH_ORIGINAL_COMMAND"; cmd_yield "$yt" "$yu";;
      *) echo "REFUSED: this key runs hello, receive, poke or yield, nothing else" >&2; exit 1;;
    esac;;
  *) echo "usage: zradio-sync run|tick|reapply|hello|beat|peer-hello|peer-poke|peer-yield|self-raise|status|keys|trust|serve-ssh (--help)" >&2; exit 2;;
esac
