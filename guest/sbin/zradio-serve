#!/usr/bin/env bash
# zradio-serve — a radio VM's two roles: serving this node's sticks to Home Assistant, or standing by with them silent.
# Runs INSIDE a radio VM as root. zradio-serve.service runs `up` and `down`; keepalived's notify (zradio-notify) starts
# and stops that unit. The floating ADDRESS is keepalived's, never this script's.
#
#   zradio-serve up       serve: the Z-Wave receiver on, then ser2net. A new turn drops this VM's sync records
#                         (synced.json, last-sync.json), so zradio-sync's tick syncs the peer once in every turn.
#                         Refused on a VM whose interfaces do not hold the floating address (--force: all the same).
#   zradio-serve down     stand by, silent: ser2net stopped, the Z-Wave receiver off, the Zigbee coordinator reset.
#                         Also at boot, before keepalived (zradio-quiet.service): a stick powers up listening.
#   zradio-serve hush     a standby silenced again: the receiver off; the coordinator reset only if it runs a network.
#                         On every BACKUP (zradio-hush.service) and every 15 min (zradio-sync tick): a stick that
#                         re-enumerates comes back listening. Nothing is done on a VM that serves, is about to, or is
#                         being written to.
#                         A stick that does not answer there is healed, rung by rung: a soft reset over the serial
#                         line, its USB device taken from the driver and given back (at most $HEAL_USB_MAX times a day),
#                         then its power — which only the node can switch: this VM asks (want-power), and the node's
#                         helper (host/hook.sh) looks once a minute. A stick whose tty stays missing for
#                         $HEAL_MISSING_AFTER s is asked for the same way.
#   zradio-serve power-wanted   the node's helper asks: `WANT stick=<kind> since=<epoch>` or `NO`. Never WANT on a
#                         VM that serves or is about to.
#   zradio-serve power-done     the helper says: the sticks' power was off and on again
#   zradio-serve check    keepalived's health check: exit 0 = this VM may hold the address
#   zradio-serve status   the role as it is: ser2net, the ttys, the markers
#
# What is done to a stick depends on its level in radios.conf (zradio-detect): `synced` sticks are switched as above;
# a `served` stick is never touched (the kit has no proven way to silence it: the standby's must hold no network).
# Measured on the reference sticks: with SetRFReceiveMode off a Z-Wave stick hears nothing (it survives a soft reset,
# not a power cycle); a reset Z-Stack coordinator stays off the air until a host starts it (state 8 or 9 after the
# reset = it started by itself: a second coordinator on the air, said loudly).
#
# check fails (keepalived: FAULT, the address goes to the peer) when: radios.conf names no radio, or a stick's tty is
# missing; no interface holds SELF (an address from DHCP that changed: the peer cannot hear this VM); a set is being
# written or was not written to the end (applying, standby-dirty); a stick stopped answering (stick-wedged); `up`
# failed less than $FAILED_FOR s ago (serve-failed); or the election's gate holds this VM (boot-wait, hold: ELECTION=act).
# The role and the serving must agree, and nothing else looks at both. So check also fails — and writes serve-failed —
# on a VM that has held the floating address for $SERVE_GRACE s (counted by the check itself, from the first time it
# saw that) with ser2net not active and nobody at the sticks (an
# `up` that never got the sticks, a ser2net that died, a read that was killed): the other VM takes over, and this one
# is tried again after $FAILED_FOR s. And hush stops a VM that serves without the address for $SERVE_GRACE s (a `down`
# that never got the sticks). "Holds the address" is what its interfaces show; keepalived's last word only where that
# cannot be seen: two notifies that come within milliseconds can be written in either order.
# A serving turn is `confirmed` or `provisional` ($RUN/turn): provisional when, in act mode, this VM serves without
# knowing that nobody is ahead of it (outdated, or nobody answered at boot); it never advances the version.
# up, down and hush hold the sticks lock (zr_sticks_lock), as do zradio-sync's read and a standby's marking before a
# write: one runs at a time, and whatever comes later has the last word.
# Journal lines: `zradio: event=serve result=…`. Tests: tests/t-serve.sh. Env: ZRADIO_SERVE_*, ZRADIO_RADIOS.
set -uo pipefail
MODE=${1:-}
LIB=${ZRADIO_LIB:-$(cd "$(dirname "$0")/../lib" 2>/dev/null && pwd)}; [ -r "$LIB/zradio-common.sh" ] || LIB=/usr/local/lib/zradio
# shellcheck source=../lib/zradio-common.sh
. "$LIB/zradio-common.sh" || exit 2
SYSTEMCTL=${ZRADIO_SERVE_SYSTEMCTL:-systemctl}
PROBE=${ZRADIO_SERVE_PROBE:-$LIB/zradio-probe.py}
# shellcheck disable=SC2034  # LOGGER and RUN are read by zradio-common.sh (zr_log, zr_markers)
LOGGER=${ZRADIO_SERVE_LOGGER:-logger}
# shellcheck disable=SC2034
RUN=${ZRADIO_SERVE_RUN:-/run/zradio}
STATE=${ZRADIO_SERVE_STATE:-/var/lib/zradio}
ZR_RF_TRIES=${ZRADIO_SERVE_TRIES:-$ZR_RF_TRIES}
ZR_RF_PAUSE=${ZRADIO_SERVE_PAUSE:-$ZR_RF_PAUSE}
ADDR_WAIT=${ZRADIO_SERVE_ADDR_WAIT:-10}  # s `up` waits for the floating address to show on an interface (keepalived sets it before its notify)
UNSERVED_GAP=20                    # s between two health checks at most (keepalived runs one every 3 s): a longer gap is a new count
SERVE_GRACE=${ZRADIO_SERVE_GRACE:-30}   # s the role and the serving may disagree while the unit's own start or stop is on its way
FAILED_FOR=${ZRADIO_SERVE_HOLD:-300}  # s a failed `up` keeps this VM out of the election (or it would claim every few s)
GATE_SLACK=240                     # s a boot-wait may outlive ELECTION_WAIT: the gate's last look (a peer hello, a
                                   # Zigbee counter raise) can run past the wait; older = the gate died
ZIGBEE_RUNNING="8|9"               # Z-Stack device states StartingAsCoordinator, StartedAsCoordinator
HEAL_USB_MAX=${ZRADIO_SERVE_HEAL_USB_MAX:-4}            # USB re-binds of one stick in 24 h at most
HEAL_MISSING_AFTER=${ZRADIO_SERVE_HEAL_MISSING_AFTER:-300}   # s a stick's tty may be missing before the node is asked for its power
SYSFS=${ZRADIO_SERVE_SYSFS:-/sys}
zr_markers
UNSERVED="$RUN/unserved-since"     # the health check's own count: when it first saw this VM hold the address without serving
RADIOS_OK=1; zr_load_radios || RADIOS_OK=0
ZW=${ZRADIO_SERVE_ZWAVE_TTY:-$ZWAVE_TTY}
ZB=${ZRADIO_SERVE_ZIGBEE_TTY:-$ZIGBEE_TTY}

say() { zr_say serve "$@"; }
# (a file for a probe's stderr; not for check and status: the health check runs every 3 s and must not write a file)
ERR=""; case "${1:-}" in check|status) ;; *) ERR=$(mktemp) || exit 1; trap 'rm -f "$ERR"' EXIT;; esac
probe_json() { python3 "$PROBE" "$@" --json 2>"$ERR"; }
why() { grep -E '^   FAIL' "$ERR" | head -1 | cut -c1-160; }
receiver() { zr_receiver "$1" "$ZW" "$ERR"; }
age_of() { local m; m=$(stat -c %Y "$1" 2>/dev/null) || { echo 999999; return; }; echo $(( $(date +%s) - m )); }
ttys() { zr_has zwave && printf '%s\n' "$ZW"; zr_has zigbee && printf '%s\n' "$ZB"; return 0; }   # the ttys this VM must have
missing() { local t out=""; while IFS= read -r t; do [ -e "$t" ] || out="$out $t"; done < <(ttys); printf '%s' "${out# }"; }
served_only() {
  local out=""
  zr_has zwave served && out="Z-Wave ($ZWAVE_FAMILY)"
  zr_has zigbee served && out="${out:+$out and }Zigbee ($ZIGBEE_FAMILY)"
  printf '%s' "$out"
}
need_radios() { # up / check: a radios.conf that names at least one radio
  [ $RADIOS_OK = 1 ] || { WHY="step=radios — $ZR_ERR"; return 1; }
  zr_has zwave || zr_has zigbee || { WHY="step=radios — $ZR_RADIOS names no radio (ZWAVE=none, ZIGBEE=none)"; return 1; }
}
fail_up() { : > "$FAILED"; say failed "$1"; exit 1; }   # fail_up <text>: not serving, out of the election for $FAILED_FOR s
sticks_lock() {
  zr_sticks_lock || { say loud "step=lock — the sticks were held for more than $ZR_LOCK_WAIT s (another zradio-serve, or a sync)"; exit 1; }
}
holds_address() { # this VM holds the floating address: seen on its interfaces, or — where that cannot be told — by keepalived's last word
  local rc; zr_holds_vip; rc=$?
  if [ $rc = 2 ]; then [ "$(zr_role)" = MASTER ]; return; fi
  return $rc
}
serves_without_address() { # ser2net is active and this VM does not hold the floating address
  zr_serving || return 1
  local rc; zr_holds_vip; rc=$?
  [ $rc != 0 ] || return 1
  [ $rc != 1 ] || return 0
  case "$(zr_role)" in BACKUP|FAULT|STOP) return 0;; esac; return 1
}
sticks_free() { ( exec 7>>"$STICKS_LOCK" && flock -n 7 ) 2>/dev/null; }      # nobody holds the sticks lock right now (it is not kept)
# ---- a stick that does not answer, on a VM that does not serve (hush): healed rung by rung
answers() { # answers zwave|zigbee: the stick answers a question now (and is left silent: receiver off / read only)
  if [ "$1" = zwave ]; then receiver off; else probe_json --zigbee "$ZB" >/dev/null; fi
}
usb_rebind() { # usb_rebind zwave|zigbee <tty>: the stick's USB device taken from its driver and given back, as if it were
  # plugged in again without losing its power. 1 when there is no such device, or the day's re-binds are used up
  local f="$STATE/heal-usb-$1" now real dev i=0
  now=$(date +%s)
  [ "$(awk -v now="$now" 'now - $1 < 86400' "$f" 2>/dev/null | grep -c .)" -lt "$HEAL_USB_MAX" ] || return 1
  real=$(readlink -f "$2" 2>/dev/null) && dev=$(readlink -f "$SYSFS/class/tty/${real##*/}/device" 2>/dev/null) || return 1
  while [ "$dev" != / ] && [ -n "$dev" ] && [ ! -e "$dev/idVendor" ]; do dev=$(dirname "$dev"); done
  [ -e "$dev/idVendor" ] && [ -e "$SYSFS/bus/usb/drivers/usb/unbind" ] || return 1
  echo "$now" >> "$f"
  echo "${dev##*/}" 2>/dev/null > "$SYSFS/bus/usb/drivers/usb/unbind" || return 1
  sleep 1
  echo "${dev##*/}" 2>/dev/null > "$SYSFS/bus/usb/drivers/usb/bind" || return 1
  while [ ! -e "$2" ] && [ $i -lt 20 ]; do sleep 1; i=$((i + 1)); done      # udev names the tty again
  [ -e "$2" ]
}
want_power() { # want_power <stick(s)> <why>: the node is asked to switch the sticks' power off and on. Said once per request
  [ ! -e "$WANT" ] || return 0
  printf '%s %s\n' "$1" "$(date +%s)" > "$WANT"
  say heal-ask "stick=$1 — $2: this VM asks its node to switch the sticks' power off and on (the kit's helper there looks once a minute; without one: stop and start this VM)"
}
heal() { # heal zwave|zigbee: 0 when the stick answers again
  local kind=$1 tty=$ZB
  [ "$kind" = zigbee ] || tty=$ZW
  # 1. a soft reset over the serial line
  if [ "$kind" = zwave ]; then probe_json --zwave "$tty" --soft-reset >/dev/null; else probe_json --zigbee "$tty" --zigbee-reset >/dev/null; fi
  if answers "$kind"; then say healed "stick=$kind by=soft-reset — it answers again"; return 0; fi
  # 2. its USB device, away from the driver and back
  if usb_rebind "$kind" "$tty" && answers "$kind"; then say healed "stick=$kind by=usb-rebind — it answers again"; return 0; fi
  # 3. its power: the node's to switch
  want_power "$kind" "it does not answer after a soft reset and a USB re-bind"
  return 1
}

case "$MODE" in
up)
  zr_need_root
  sticks_lock
  if zr_serving; then rm -f "$FAILED"; say up-already "ser2net is active: this VM serves already — nothing done"; exit 0; fi
  # Only where the floating address is: a start that reaches this unit without it (keepalived's MASTER and BACKUP
  # notifies a few milliseconds apart, taken by systemd in the other order; a start by hand on the standby) would put
  # a second listening stick beside the VM that serves. Not a failed `up`: this VM stays in the election.
  if [ "${2:-}" != --force ] && zr_load_conf 2>/dev/null; then
    t=0; while zr_holds_vip; [ $? = 1 ] && [ "$t" -lt "$ADDR_WAIT" ]; do sleep 1; t=$((t + 1)); done
    zr_holds_vip; if [ $? = 1 ]; then
      say loud "step=no-address — no interface of this VM holds the floating address ${VIP%/*} (keepalived's last word: $(zr_role)): \
nothing started, no stick touched. The VM that holds it serves (zradio-serve up --force starts this one all the same)"
      exit 1
    fi
  fi
  need_radios || fail_up "$WHY: not serving"
  gone=$(missing)
  [ -z "$gone" ] || fail_up "step=tty — no $gone: a stick is gone; not serving"
  [ ! -e "$WEDGED" ] || fail_up "step=wedged — $WEDGED ($(cat "$WEDGED" 2>/dev/null)): a stick here stopped answering; not serving until \
the sticks answer a probe (zradio-serve hush tries; a hung stick wants a power cycle: stop and start this VM)"
  [ ! -e "$DIRTY" ] || fail_up "step=dirty — $DIRTY: a synced image was not written to the end on these sticks; not serving \
(zradio-sync reapply, or a new sync, clears it)"
  if zr_has zwave synced && ! receiver on; then
    fail_up "step=zwave-receiver — SetRFReceiveMode on did not answer in $ZR_RF_TRIES tries ($(why)): not serving, out of the election for $FAILED_FOR s"
  fi
  # the kind of turn is written BEFORE the ports open: the peer never sees a serving VM without one
  turn=confirmed
  if zr_load_conf 2>/dev/null && [ "$ELECTION" = act ] && { [ -e "$OUTDATED" ] || [ -e "$ALONE" ]; }; then turn=provisional; fi
  echo "$turn" > "$TURN_F"
  if ! "$SYSTEMCTL" start ser2net || ! zr_serving; then
    rm -f "$TURN_F"
    # the receiver was just turned on: off again, or this stick listens to the mesh beside the VM that takes over
    # (systemd runs no ExecStop — `down` — after a start that failed)
    if zr_has zwave synced && ! receiver off; then say loud "step=zwave-receiver — SetRFReceiveMode off did not answer after ser2net failed to start ($(why)): this stick still listens to the mesh"; fi
    fail_up "step=ser2net — ser2net did not start: not serving, out of the election for $FAILED_FOR s"
  fi
  # a new turn: these sticks are no longer "a copy of sync X" (synced.json), and what this VM sent in an earlier turn
  # (last-sync.json) says nothing about the peer now. With both gone, the tick syncs the peer once in this turn — the
  # sync that lifts the returning VM's Zigbee frame counter above this one's.
  rm -f "$STATE/synced.json" "$STATE/last-sync.json" "$STATE/sync-pending.json" "$FAILED"      # (a pending mark of an earlier turn: its failed tries are not this turn's)
  if [ $turn = provisional ]; then
    if [ -e "$OUTDATED" ]; then why_p="it is outdated: $(cat "$OUTDATED" 2>/dev/null)"; else why_p="the peer did not answer at boot"; fi
    say provisional "this VM serves without knowing that it holds the newest networks ($why_p): its version does not advance, \
and a more advanced peer takes the radios back when it returns"
  fi
  if zr_has zwave synced; then say up "the Z-Wave receiver is on and ser2net is started — Home Assistant connects (ZHA starts the coordinator)"
  else say up "ser2net is started — Home Assistant connects"; fi
  exit 0;;

down)
  zr_need_root
  sticks_lock; rc=0; gone=""; did=""
  rm -f "$TURN_F" "$WOULD_TURN"
  if zr_serving; then "$SYSTEMCTL" stop ser2net || true; fi
  if zr_serving; then say loud "step=ser2net — ser2net did not stop: this VM still answers Home Assistant"; exit 1; fi
  [ $RADIOS_OK = 1 ] || { say down-partial "ser2net is stopped; $ZR_ERR: no stick is known here, none was silenced"; exit 0; }
  if zr_has zwave synced; then
    if [ ! -e "$ZW" ]; then gone="$gone $ZW"
    elif receiver off; then did="$did, the Z-Wave receiver is off"
    else say loud "step=zwave-receiver — SetRFReceiveMode off did not answer in $ZR_RF_TRIES tries ($(why)): this stick still listens to the mesh"; rc=1; fi
  fi
  if zr_has zigbee synced; then
    if [ ! -e "$ZB" ]; then gone="$gone $ZB"
    elif ! J=$(probe_json --zigbee "$ZB" --zigbee-reset); then
      say loud "step=zigbee — the coordinator reset did not answer ($(why)): its state is unknown"; rc=1
    else
      st=$(zr_json - zigbee.device_state <<<"$J")
      if [[ "$st" =~ ^($ZIGBEE_RUNNING)$ ]]; then
        say loud "step=zigbee — the coordinator is in state $(zr_json - zigbee.device_state_name <<<"$J") ($st) after the reset: \
it runs the network by itself, a second coordinator is on the air"; rc=1
      else did="$did, the coordinator is reset"; fi
    fi
  fi
  so=$(served_only); [ -z "$so" ] || did="$did; $so is served only: not touched (its standby stick must hold no network)"
  if [ $rc = 0 ] && [ -z "$gone" ]; then say down "ser2net is stopped$did — silent standby"
  elif [ $rc = 0 ]; then say down-partial "ser2net is stopped; no tty for$gone: that stick could not be silenced (hush does it when the tty is back)"; fi
  if [ -n "$gone" ]; then [ -e "$MISSING_SINCE" ] || date +%s > "$MISSING_SINCE"; fi
  exit $rc;;

hush)
  zr_need_root
  # a VM that serves without the role (its unit's stop never got the sticks, or never came): stopped here, once the
  # role has been settled for a while — a stop that is on its way is left to finish
  zr_load_conf 2>/dev/null || true
  if serves_without_address && [ "$(age_of "$ROLE_F")" -ge "$SERVE_GRACE" ]; then
    say loud "step=role — ser2net is active and this VM does not hold the floating address (keepalived's last word: $(zr_role), $(age_of "$ROLE_F") s ago): it serves without the role. Stopping it"
    "$SYSTEMCTL" stop zradio-serve.service || true      # its ExecStop is `zradio-serve down`
    if zr_serving; then rm -f "$ERR"; exec bash "$0" down; fi      # the unit was not active, so its stop did nothing
    exit 0
  fi
  if zr_master_or_serving; then echo "this VM serves or is about to — nothing to hush"; exit 0; fi
  [ $RADIOS_OK = 1 ] || { echo "$ZR_ERR — nothing to hush"; exit 0; }
  sticks_lock
  # again under the lock: an up that ran meanwhile has the last word, and a write that has begun is not disturbed
  if zr_master_or_serving; then echo "this VM serves — nothing to hush"; exit 0; fi
  if [ -e "$APPLYING" ]; then echo "a synced set is being written — nothing to hush"; exit 0; fi
  rc=0
  if zr_has zwave synced && [ -e "$ZW" ] && ! receiver off && ! heal zwave; then
    say loud "step=zwave-receiver — hush: SetRFReceiveMode off did not answer in $ZR_RF_TRIES tries ($(why)): this standby stick may listen to the mesh"; rc=1
  fi
  if zr_has zigbee synced && [ -e "$ZB" ]; then
    if ! J=$(probe_json --zigbee "$ZB") && ! { heal zigbee && J=$(probe_json --zigbee "$ZB"); }; then say loud "step=zigbee — hush: the coordinator did not answer a read ($(why))"; rc=1
    else
      st=$(zr_json - zigbee.device_state <<<"$J")
      if [[ "$st" =~ ^($ZIGBEE_RUNNING)$ ]]; then
        say loud "step=zigbee — hush: the standby's coordinator runs the network (state $st): reset now"
        probe_json --zigbee "$ZB" --zigbee-reset >/dev/null || rc=1
      fi
    fi
  fi
  if [ -e "$WEDGED" ]; then
    wk=$(cut -d' ' -f1 "$WEDGED" 2>/dev/null); case "$wk" in zwave|zigbee) ;; *) wk="";; esac      # the stick the mark names
    if [ -n "$wk" ] && ! zr_has "$wk" synced; then
      echo "stick-wedged stays: it names the $wk stick, which is served only — the kit has no question it could ask that stick. After a power cycle of it (stop and start this VM): rm $WEDGED"
    elif [ $rc = 0 ] && [ -z "$(missing)" ]; then
      rm -f "$WEDGED"; say unwedged "both sticks answer again: stick-wedged is removed, this VM may stand by and serve"
    else echo "stick-wedged stays: a stick still does not answer (the node was asked for a power cycle; by hand: stop and start this VM)"; fi
  fi
  # a stick whose tty is not there: after a while, its power is asked for too (a hub that did not come back)
  gone=$(missing)
  if [ -n "$gone" ]; then
    [ -e "$MISSING_SINCE" ] || date +%s > "$MISSING_SINCE"
    since=$(cat "$MISSING_SINCE" 2>/dev/null); [[ "$since" =~ ^[0-9]+$ ]] || since=$(date +%s)
    [ $(( $(date +%s) - since )) -lt "$HEAL_MISSING_AFTER" ] || want_power "$(for t in $gone; do [ "$t" = "$ZW" ] && echo zwave || echo zigbee; done | paste -sd, -)" "no tty for $gone for $(( $(date +%s) - since )) s"
  else
    rm -f "$MISSING_SINCE"
    if [ $rc = 0 ] && [ -e "$WANT" ]; then
      by=""; [ ! -e "$POWERED" ] || [ "$(cat "$POWERED" 2>/dev/null)" -lt "$(cut -d' ' -f2 "$WANT" 2>/dev/null)" ] 2>/dev/null || by=" by=power-cycle"
      say healed "stick=$(cut -d' ' -f1 "$WANT" 2>/dev/null)$by — the sticks are there and answer: the request for their power is withdrawn"
      rm -f "$WANT"
    fi
  fi
  [ $rc = 0 ] && echo "hush: the receiver is off, the coordinator is not on the air"
  exit $rc;;

check)
  need_radios || exit 1
  [ -z "$(missing)" ] || exit 1
  if zr_load_conf 2>/dev/null; then zr_holds_self || exit 1; fi    # (ELECTION_WAIT keeps its default without a conf)
  for m in "$APPLYING" "$DIRTY" "$WEDGED" "$HOLD"; do [ ! -e "$m" ] || exit 1; done
  [ -e "$BOOT_WAIT" ] && [ "$(age_of "$BOOT_WAIT")" -lt $((ELECTION_WAIT + GATE_SLACK)) ] && exit 1
  [ -e "$FAILED" ] && [ "$(age_of "$FAILED")" -lt "$FAILED_FOR" ] && exit 1
  # the role without the serving, with nobody working on it (up, down, hush and a sync's read all hold the sticks lock)
  # The $SERVE_GRACE s are counted by this check itself, from the first time it sees that — never by the role file's
  # age: keepalived sets the address and then runs its notify, so a check in between sees the address with a role
  # file of hours ago. The file holds the first sighting; its own age says whether the sightings were one after the
  # other (a check that passed in between, or that never ran, starts the count again).
  if holds_address && ! zr_serving; then
    since=$(cat "$UNSERVED" 2>/dev/null); now_s=$(date +%s)
    if [[ "$since" =~ ^[0-9]{1,12}$ ]] && [ "$(age_of "$UNSERVED")" -le "$UNSERVED_GAP" ]; then echo "$since" > "$UNSERVED"; else since=$now_s; echo "$since" > "$UNSERVED"; fi
  else since=""; [ ! -e "$UNSERVED" ] || rm -f "$UNSERVED"; fi
  if [ -n "$since" ] && [ $((now_s - since)) -ge "$SERVE_GRACE" ] && sticks_free; then
    : > "$FAILED"; rm -f "$UNSERVED"
    zr_log serve loud "step=not-serving — this VM holds the floating address (keepalived's last word: $(zr_role), $(age_of "$ROLE_F") s ago), ser2net is not active and nobody is at the sticks: it holds the address without serving. Out of the election for $FAILED_FOR s: the other VM takes the role"
    exit 1
  fi
  exit 0;;

status)
  zr_serving && echo "ser2net: active (serving)" || echo "ser2net: not active (standby)"
  if [ $RADIOS_OK = 1 ]; then
    echo "radios: Z-Wave $ZWAVE${ZWAVE_FAMILY:+ ($ZWAVE_FAMILY)}, Zigbee $ZIGBEE${ZIGBEE_FAMILY:+ ($ZIGBEE_FAMILY)}"
    while IFS= read -r t; do [ -e "$t" ] && echo "tty: $t present" || echo "tty: $t MISSING"; done < <(ttys)
  else echo "radios: $ZR_ERR"; fi
  [ -e "$APPLYING" ] && echo "marker: $APPLYING (a synced image is being written)"
  [ -e "$DIRTY" ] && echo "marker: $DIRTY (a synced image was not written to the end: this VM may not serve)"
  [ -e "$WEDGED" ] && echo "marker: $WEDGED ($(cat "$WEDGED" 2>/dev/null): a stick stopped answering; this VM may not serve until the sticks answer a probe)"
  [ -e "$WANT" ] && echo "marker: $WANT ($(cat "$WANT" 2>/dev/null): this VM asks its node to switch the sticks' power off and on$([ ! -e "$POWERED" ] || echo "; last done $(age_of "$POWERED") s ago"))"
  [ -e "$FAILED" ] && echo "marker: $FAILED ($(age_of "$FAILED") s old; holds this VM out for $FAILED_FOR s)"
  [ -e "$BOOT_WAIT" ] && echo "marker: $BOOT_WAIT (asking the peer who holds the newer networks before this VM may claim)"
  [ -e "$HOLD" ] && echo "marker: $HOLD (this VM holds an older copy: it may serve only after the peer has been silent for the standard wait)"
  if zr_load_conf 2>/dev/null; then
    zr_holds_self || echo "address: this VM does not hold its address $SELF any more (it holds ${ZR_HOLDS:-none}): the other VM cannot hear it, \
so it does not serve. An address from DHCP that changed: give this VM $SELF back (a reservation in the DHCP server), or pair the two again on the new one"
    [ -n "$PEER" ] || echo "peer: none yet (the pair's other VM is not installed: this VM holds the floating address alone)"
  fi
  [ -e "$OUTDATED" ] && echo "outdated: the peer was ahead ($(cat "$OUTDATED" 2>/dev/null)); a sync clears this"
  zr_version_read "$STATE"; echo "version: term $ZR_TERM, used $ZR_USED$([ -f "$TURN_F" ] && echo "; this turn is $(cat "$TURN_F")")"
  [ -f "$ROLE_F" ] && echo "keepalived's last word: $(cat "$ROLE_F")"
  exit 0;;

power-wanted)
  if [ -e "$WANT" ] && ! zr_master_or_serving && read -r wk ws < "$WANT" && [[ "$wk" =~ ^[a-z,]+$ ]] && [[ "$ws" =~ ^[0-9]+$ ]]; then echo "WANT stick=$wk since=$ws"
  else echo "NO"; fi
  exit 0;;

power-done)
  zr_need_root
  date +%s > "$POWERED"
  say power-cycled "the node switched the sticks' power off and on (asked for: $(cat "$WANT" 2>/dev/null || echo "nothing on record")); hush looks at them when their ttys are back"
  exit 0;;

-h|--help) sed -n '2,/^set -uo pipefail$/{/^set -uo pipefail$/!p}' "$0"; exit 0;;

*) echo "usage: zradio-serve up [--force]|down|hush|check|status|power-wanted|power-done (--help)" >&2; exit 2;;
esac
