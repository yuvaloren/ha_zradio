#!/usr/bin/env bash
# zradio-switch — the planned switch of the radio pair: this VM (the active) hands the radios to the standby. Runs
# INSIDE the ACTIVE radio VM as root; /usr/local/sbin/zradio-switch. Report mode unless --run.
#
#   zradio-switch [--run] [--sync]
#   zradio-switch --run --yield     called by zradio-sync when a more advanced peer asks for the radios (docs/DESIGN.md,
#                                   "Who serves when it is not obvious"): no sync first (this VM's copy is the older
#                                   one), and this VM is marked outdated and held — before keepalived runs here again —
#                                   until the peer's sync lands
#
# Steps with --run:
#   0. checks: this VM serves (ser2net active, keepalived's last word MASTER); the standby answers hello as BACKUP, not
#      serving, not dirty, not applying, and not held by the election's gate (wait).
#   1. the standby's copy: when it does not hold this VM's last sync (or --sync), one `zradio-sync run --reason switch`
#      first — that sync is its own short pause for Home Assistant; a standby that holds the last sync is taken as it is.
#   2. systemctl stop keepalived here: its last advert has priority 0, the standby takes the floating address at once
#      and serves (its receiver on, ser2net); this VM's serving stops with keepalived (the unit's ExecStopPost) and its
#      sticks go silent.
#   3. wait (20 s at most) until the standby says MASTER and serving; then keepalived is started here again: this VM is
#      the standby now (nopreempt: it does not take the role back).
#   If the standby did not take the role in 20 s: keepalived is started here anyway — with no other MASTER this VM takes
#   the address back within about 10 s — and the exit is 1. The same when this script is interrupted in between.
# Afterward the new active's tick (every 15 min) syncs this VM once: the copy of a VM that just gave the role away has
# a Zigbee frame counter BELOW the new active's, and only a sync raises it.
# [V reference pair 2026-11-11: Home Assistant's Z-Wave back after 1.3 s, Zigbee after 7 s.]
# Journal lines: `zradio: event=switch result=…`. Tests: tests/t-switch.sh. Env: ZRADIO_SWITCH_*.
set -uo pipefail
DO=0 SYNC=0 YIELD=0
while [ $# -gt 0 ]; do case "$1" in --run) DO=1; shift;; --sync) SYNC=1; shift;; --yield) YIELD=1; shift;;
  -h|--help) sed -n '2,/^set -uo pipefail$/{/^set -uo pipefail$/!p}' "$0"; exit 0;; *) echo "unknown arg: $1" >&2; exit 2;; esac; done
LIB=${ZRADIO_LIB:-$(cd "$(dirname "$0")/../lib" 2>/dev/null && pwd)}; [ -r "$LIB/zradio-common.sh" ] || LIB=/usr/local/lib/zradio
# shellcheck source=../lib/zradio-common.sh
. "$LIB/zradio-common.sh" || exit 2
SYNCCMD=${ZRADIO_SWITCH_SYNC:-/usr/local/sbin/zradio-sync}
SYSTEMCTL=${ZRADIO_SWITCH_SYSTEMCTL:-systemctl}
# shellcheck disable=SC2034  # read by zradio-common.sh's helpers (zr_log, zr_serving)
LOGGER=${ZRADIO_SWITCH_LOGGER:-logger}
STATE=${ZRADIO_SWITCH_STATE:-/var/lib/zradio}
# shellcheck disable=SC2034  # read by zradio-common.sh (zr_markers)
RUN=${ZRADIO_SWITCH_RUN:-/run/zradio}
WAIT=${ZRADIO_SWITCH_WAIT:-20}     # s for the standby to say MASTER and serving
POLL=0.5                           # s between two of its hellos
zr_markers
log() { zr_log switch "$@"; }
peer_hello() { "$SYNCCMD" peer-hello 2>/dev/null | tail -1; }
[ "$(id -u)" = 0 ] || { bad "not root"; exit 1; }

echo "== 0. checks ($([ $DO = 1 ] && echo RUN || echo REPORT) mode) =="
role=$(zr_role)
zr_serving && [ "$role" = MASTER ] && ok "this VM is the active (ser2net active, keepalived's last word MASTER)" \
  || bad "this VM is not the active (ser2net $("$SYSTEMCTL" is-active ser2net 2>/dev/null | head -1), keepalived's last word $role): \
run zradio-switch on the VM that serves"
H=$(peer_hello) || true
case "$H" in
  HELLO\ *)
    if [ "$(zr_field "$H" role)" = BACKUP ] && [ "$(zr_field "$H" serving)" = no ] && [ "$(zr_field "$H" dirty)" = no ] \
       && [ "$(zr_field "$H" applying)" = no ] && [ "$(zr_field "$H" wait)" != yes ]; then ok "the standby is ready: $H"
    else bad "the standby is not ready to take the role: $H"; fi;;
  *) bad "the standby does not answer (zradio-sync peer-hello): no switch into the dark";;
esac
MINE=$(zr_json "$STATE/last-sync.json" gen)
THEIRS=$(zr_field "${H:-}" gen)
NEED_SYNC=0
PEER_TERM=$(zr_field "${H:-}" term); PEER_FLOOR=$(zr_field "${H:-}" zbfloor)
if [ $YIELD = 1 ]; then ok "--yield: the peer holds the newer networks: no sync from here"
elif [ $SYNC = 1 ]; then NEED_SYNC=1; ok "--sync: one sync before the switch"
elif [ -n "$MINE" ] && [ "$MINE" = "$THEIRS" ]; then ok "the standby holds this VM's last sync ($MINE): taken as it is"
else NEED_SYNC=1; ok "the standby holds '${THEIRS:-nothing}', this VM's last sync is '${MINE:-none}': one sync first"; fi
echo "== checks: $FAILS FAIL =="
[ $FAILS -eq 0 ] || { echo "REFUSED: fix the FAIL lines; nothing was changed"; exit 1; }
if [ $DO = 0 ]; then
  [ $NEED_SYNC = 1 ] && would "zradio-sync run --reason switch (its own short pause for Home Assistant)"
  would "systemctl stop keepalived (the standby takes the floating address and serves); wait for it; systemctl start keepalived (this VM becomes the standby)"
  echo "REPORT ONLY — nothing changed. Re-run with --run."; exit 0
fi

if [ $NEED_SYNC = 1 ]; then
  echo "== 1. the sync first =="
  "$SYNCCMD" run --reason switch 2>&1 | sed 's/^/    /'; src=${PIPESTATUS[0]}
  if [ "$src" = 75 ]; then      # another sync holds the lock: it may be reading, sending, or waiting to try again
    bad "another sync is running — no switch onto a copy nobody confirmed (this VM still serves). When it has ended: this again"; log failed "step=sync busy"; exit 1
  elif [ "$src" != 0 ]; then
    bad "the sync did not end clean — no switch onto a copy that was not confirmed (this VM still serves)"; log failed "step=sync"; exit 1
  fi
  done_ "the standby holds a fresh copy"
fi
echo "== 2. the switch =="
T0=$(zr_now)
# From the stop to the start, this VM is out of the pair. However this script ends in between — Ctrl-C, a dropped
# session, a kill — keepalived is started here again: with the standby serving this VM stands by; with nobody serving
# it takes the address back.
KA_DOWN=0
back() { local rc=$?; trap - EXIT INT TERM HUP; [ $KA_DOWN = 0 ] || "$SYSTEMCTL" start keepalived || true; exit $rc; }
trap back EXIT; trap 'exit 143' TERM; trap 'exit 130' INT; trap 'exit 129' HUP
KA_DOWN=1
"$SYSTEMCTL" stop keepalived || { KA_DOWN=0; bad "systemctl stop keepalived failed — this VM still serves"; log failed "step=stop"; exit 1; }
done_ "keepalived stopped here after $(zr_since "$T0") s (priority-0 advert sent; this VM's serving stops with it)"
took=""
# $WAIT seconds, by the clock: a hello that hangs (the standby's ssh stops answering) is cut off at what is left of them
SECONDS=0
for _ in $(seq 1 "$(awk -v w="$WAIT" -v p="$POLL" 'BEGIN { print int(w / p) }')"); do
  left=$((WAIT - SECONDS)); [ $left -ge 1 ] || break
  H=$(timeout "$left" "$SYNCCMD" peer-hello 2>/dev/null | tail -1) || true
  if [ "$(zr_field "$H" role)" = MASTER ] && [ "$(zr_field "$H" serving)" = yes ]; then took=$(zr_since "$T0"); break; fi
  sleep "$POLL"
done
MARKED=0
if [ -n "$took" ]; then
  # before keepalived runs here again, under the version lock (the peer's sync may land from now on): this VM no longer
  # claims to be the copy in use (zradio-notify did that when keepalived stopped; once more for a notify that did not
  # run), and with --yield it is outdated AND held — from its first second as a standby it cannot take the radios back
  # with the older copy — unless the peer's sync has landed already (then its term is not below the peer's any more)
  if zr_version_lock; then
    zr_version_read "$STATE"
    [ "$ZR_USED" = no ] || zr_version_write "$STATE" "$ZR_TERM" no
    if [ $YIELD = 1 ] && [[ "${PEER_TERM:-}" =~ ^[0-9]+$ ]] && [ "$ZR_TERM" -lt "$PEER_TERM" ]; then
      echo "term=$PEER_TERM zbfloor=${PEER_FLOOR:-0}" > "$OUTDATED" && : > "$HOLD" && MARKED=1
    fi
    zr_version_unlock
  else bad "the version lock was held for more than $ZR_LOCK_WAIT s: the version and the outdated mark were not written"; fi
fi
KA_DOWN=0
"$SYSTEMCTL" start keepalived || bad "systemctl start keepalived failed here — this VM is out of the pair until it runs"
if [ -n "$took" ]; then
  done_ "the standby says MASTER and serving $took s after the stop; keepalived runs here again (this VM is the standby)"
  [ $MARKED = 0 ] || done_ "this VM is marked outdated ($OUTDATED) and held until the peer's sync lands"
  log ok "took_s=$took — the peer serves; this VM is the standby (the peer's tick syncs it within 15 min)"
  [ $FAILS -eq 0 ] || exit 1
  exit 0
fi
bad "the standby did not say MASTER and serving within $WAIT s (last answer: ${H:-nothing}) — keepalived is started here again: \
with no other MASTER this VM takes the address back"
log failed "step=takeover — the peer did not take the role in $WAIT s; keepalived restarted here"
exit 1
